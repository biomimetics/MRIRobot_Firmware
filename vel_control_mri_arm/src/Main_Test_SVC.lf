// Regression check for Small_Velocity_Controller's FCS-MPC logic. Runs
// natively (no STM32 hardware/cross-compiler needed) and drives a single
// controller instance with a slow triangle-wave velocity trajectory,
// printing rolling tracking statistics (see TrackingLogger below) so you
// can eyeball whether motionDebt stays bounded and pass-through/
// small-velocity mode switches happen where expected.
//
// Build:
//   cd vel_control_mri_arm
//   lfc-dev src/Main_Test_SVC.lf
//
// Run:
//   ./bin/Main_Test_SVC
//
// Note: PRINT_SVC must be set to 1 in src_c/pulse_mpc.h for TrackingLogger
// to see anything -- debug_info is only ever populated/emitted under that
// flag (see Small_Velocity_Controller.lf's control_tick reaction). Remember
// to flip it back to 0 before flashing production firmware, since it also
// enables Small_Velocity_Controller_Bank.lf's periodic UART printout.
target C {
  fast: true,
  timeout: 20 s
}

// No `platform` override here -- unlike Main.lf/Main_TXRX.lf, this test
// harness is meant to run natively on the dev machine (not the STM32) so we
// can iterate on Small_Velocity_Controller's logic quickly without
// flashing hardware. Small_Velocity_Controller.lf itself has no HAL/STM32
// dependencies (pulse_mpc.c is plain, dependency-free C), so it should
// build and run fine here even though its own target block still requests
// the stm32 platform for the real firmware build.
import Small_Velocity_Controller from "lib/SmallVelocityControl/Small_Velocity_Controller.lf"

preamble {=
  #include "pulse_mpc.h"
  #include <math.h>
=}

// Generates a slow triangle wave: 0 -> +amplitude -> 0 -> -amplitude -> 0,
// looping every cycle_period. Default amplitude is 40 deg/s (well above the
// default V_min ~17 deg/s), so the trajectory spends most of its time in
// pass-through mode and dips into small-velocity bang-bang mode near each
// zero-crossing -- exercising both modes and the transitions between them.
reactor VelocitySignalGenerator(
  gen_period: time = 10 ms,
  cycle_period: time = 8 s,
  amplitude: float = 0.6981 // rad/s, ~40 deg/s
) {
  output command_velocity: float

  timer t(0, gen_period)

  reaction(t) -> command_velocity {=
    instant_t now = lf_time_logical();
    double cycle_ns = (double) self->cycle_period;
    double phase = fmod((double) now, cycle_ns) / cycle_ns; // in [0, 1)

    float v;
    if (phase < 0.25) {
      v = self->amplitude * (float) (phase / 0.25);
    } else if (phase < 0.5) {
      v = self->amplitude * (float) (1.0 - (phase - 0.25) / 0.25);
    } else if (phase < 0.75) {
      v = -self->amplitude * (float) ((phase - 0.5) / 0.25);
    } else {
      v = -self->amplitude * (float) (1.0 - (phase - 0.75) / 0.25);
    }

    lf_set(command_velocity, v);
  =}
}

// Consumes the SVC's debug_info (only populated when PRINT_SVC is enabled
// in pulse_mpc.h -- it must be set to 1 for this test to see anything) and
// reports rolling tracking statistics every report_period. motionDebt is
// the controller's own signed position-tracking error (desired minus
// model-predicted actual motion), so its magnitude staying bounded --
// rather than growing without limit -- is the main thing to check: it
// means the bang-bang pulsing is successfully keeping up with the average
// commanded velocity.
reactor TrackingLogger(report_period: time = 1 s) {
  input debug_info: SVCDebugInfo

  state sample_count: int = 0
  state sum_abs_debt: float = 0.0
  state max_abs_debt: float = 0.0
  state passthrough_samples: int = 0
  state smallvel_samples: int = 0

  reaction(debug_info) {=
    float abs_debt = fabsf(debug_info->value.motionDebt);
    self->sum_abs_debt += abs_debt;
    if (abs_debt > self->max_abs_debt) self->max_abs_debt = abs_debt;
    if (debug_info->value.passThrough) {
      self->passthrough_samples++;
    } else {
      self->smallvel_samples++;
    }
    self->sample_count++;
  =}

  timer report_tick(0, report_period)

  reaction(report_tick) {=
    float mean_abs_debt = (self->sample_count > 0) ? (self->sum_abs_debt / self->sample_count) : 0.0f;
    printf(
        "[TrackingLogger] samples=%d passthrough=%d small_vel=%d mean|debt|=%d max|debt|=%d (milli-rad)\n",
        self->sample_count, self->passthrough_samples, self->smallvel_samples,
        (int) (mean_abs_debt * 1000.0f), (int) (self->max_abs_debt * 1000.0f));

    // Rolling window -- reset for the next report_period.
    self->sum_abs_debt = 0.0f;
    self->max_abs_debt = 0.0f;
    self->passthrough_samples = 0;
    self->smallvel_samples = 0;
    self->sample_count = 0;
  =}
}

main reactor {
  gen = new VelocitySignalGenerator()
  svc = new Small_Velocity_Controller()
  logger = new TrackingLogger()

  gen.command_velocity -> svc.command_velocity_input
  svc.debug_info -> logger.debug_info
}
