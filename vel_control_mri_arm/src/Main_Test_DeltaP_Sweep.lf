// Closed-loop sweep harness for tuning Small_DeltaP_Controller's cost
// weights (W_error/k_overshoot/C_overshoot/sigma0) against a position step
// commanded by an outer PositionPidController -> Small_DeltaP_Controller ->
// FakeMotorPlant loop -- the delta-position analogue of
// Main_Test_SVC_Sweep.lf. scripts/sweep_deltap_weights.py runs this binary
// many times to compare how different weight combinations trade off pulse
// count against settling time and (the new metric this design cares about,
// unlike the old motion-debt sweep) overshoot frequency/magnitude.
//
// ---- Quickstart ----
//   cd vel_control_mri_arm
//   python3 scripts/sweep_deltap_weights.py --build
// That single command flips PRINT_DPOS to 1, builds this file with
// `lfc-dev`, reverts PRINT_DPOS to 0, then runs the default weight grid
// (subprocess runs of the binary this file compiles to, each with different
// DPOS_W_ERROR/DPOS_K_OVERSHOOT/DPOS_C_OVERSHOOT/DPOS_SIGMA0 env vars).
// Results land in csv_data/deltap_sweep/. On later sweeps, once this file
// and dpos_pulse_mpc.c/h are unchanged, drop --build to reuse the existing
// binary and skip recompiling.
//
// The cost weights, PID gains, target position, and CSV output path are all
// overridable via environment variables (read once at startup via getenv()
// in the instantiation arguments below) so a whole sweep only needs one
// `lfc-dev` build -- scripts/sweep_deltap_weights.py sets these env vars
// before each subprocess run of this *same* compiled binary.
// (T_start_initial/T_stop_initial/minimumPulseWidth_initial/lookahead_depth
// are NOT overridden here -- LF only accepts compile-time time literals for
// time-typed parameters, not runtime getenv()-based expressions, same
// caveat as Main_Test_SVC_Sweep.lf's H_initial note; they stay at
// Small_DeltaP_Controller's own defaults for every sweep run.)
//
// Build directly (bypassing the sweep script -- you must flip PRINT_DPOS to
// 1 in src_c/dpos_pulse_mpc.h yourself first, see Note below):
//   lfc-dev src/Main_Test_DeltaP_Sweep.lf
//
// Run one configuration directly (every env var optional, falls back to
// the defaults below):
//   DPOS_W_ERROR=1.0 DPOS_K_OVERSHOOT=10.0 DPOS_C_OVERSHOOT=0.01 DPOS_SIGMA0=0.01 \
//     DPOS_TARGET_POSITION=1.0 DPOS_CSV_PATH=csv_data/manual_run.csv \
//     ./bin/Main_Test_DeltaP_Sweep
// ...then plot that one CSV the same way as a Main_Test_DeltaP_Csv.lf run:
//   python3 scripts/plot_deltap_test.py csv_data/manual_run.csv
//
// Note: PRINT_DPOS must be set to 1 in src_c/dpos_pulse_mpc.h at *build*
// time for debug_info (and therefore the CSV) to see anything real -- see
// Small_DeltaP_Controller.lf's control_tick reaction. This only matters
// when compiling; scripts/sweep_deltap_weights.py's --build flag flips it,
// builds, and flips it back automatically, so the checked-in source is
// always left at PRINT_DPOS=0. Remember to do the same (flip back to 0) if
// you ever build this file manually. It must stay 0 before flashing
// production firmware.
target C {
  fast: true,
  timeout: 20 s
}

// No `platform` override here -- same reasoning as Main_Test_DeltaP.lf:
// this harness runs natively on the dev machine, not the STM32.
import Small_DeltaP_Controller from "lib/Drivers/SmallDeltaPControl/Small_DeltaP_Controller.lf"
import FakeMotorPlant from "lib/Helpers/FakeMotorPlant.lf"
import DeltaPCsvLogger from "lib/Helpers/DeltaPCsvLogger.lf"
import PositionPidController from "lib/Helpers/PositionPidController.lf"

preamble {=
  #include <stdlib.h>
=}

main reactor {
  pid = new PositionPidController(
    target_position = {= getenv("DPOS_TARGET_POSITION") ? atof(getenv("DPOS_TARGET_POSITION")) : 1.0f =},
    kp = {= getenv("DPOS_PID_KP") ? atof(getenv("DPOS_PID_KP")) : 2.0f =},
    ki = {= getenv("DPOS_PID_KI") ? atof(getenv("DPOS_PID_KI")) : 0.0f =},
    kd = {= getenv("DPOS_PID_KD") ? atof(getenv("DPOS_PID_KD")) : 0.1f =}
  )
  controller = new Small_DeltaP_Controller(
    W_error_initial = {= getenv("DPOS_W_ERROR") ? atof(getenv("DPOS_W_ERROR")) : 1.0f =},
    k_overshoot_initial = {= getenv("DPOS_K_OVERSHOOT") ? atof(getenv("DPOS_K_OVERSHOOT")) : 10.0f =},
    C_overshoot_initial = {= getenv("DPOS_C_OVERSHOOT") ? atof(getenv("DPOS_C_OVERSHOOT")) : 0.01f =},
    sigma0_initial = {= getenv("DPOS_SIGMA0") ? atof(getenv("DPOS_SIGMA0")) : 0.01f =}
  )
  plant = new FakeMotorPlant()
  logger = new DeltaPCsvLogger(
    csv_path = {= getenv("DPOS_CSV_PATH") ? getenv("DPOS_CSV_PATH") : "csv_data/deltap_test_log.csv" =}
  )

  pid.command_velocity -> controller.command_velocity_input
  pid.remaining_error -> controller.remaining_error_input
  controller.command_velocity_output -> plant.command_velocity
  controller.debug_info -> logger.debug_info
  plant.real_velocity -> logger.real_velocity
  plant.position -> logger.position

  // `after` is required here to break the pid -> controller -> plant -> pid
  // feedback cycle (LF disallows zero-delay cycles among reactors) -- same
  // pattern as Main_Test_SVC_Sweep.lf.
  plant.position -> pid.position_feedback after 1 ms
}
