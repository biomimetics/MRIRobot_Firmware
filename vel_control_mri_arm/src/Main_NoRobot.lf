// Hardware-in-the-loop comms test: runs on the real STM32 (real UART DMA,
// real clocks/timers, real serial link to ROS2), but with QDEC/USM replaced
// by a per-joint FakeMotorPlant (the same simulated-motor reactor the native
// Main_Test_DeltaP*.lf harnesses use) standing in for the physical arm.
//
// Point of this file: validate the STM32<->ROS2 wire link and
// Small_DeltaP_Controller end to end, without a robot attached -- ROS2 sends
// real CommandMessage packets over the real serial port, State_Machine and
// Small_DeltaP_Controller_Bank run exactly as they would in production, and
// the StateMessage sent back reflects FakeMotorPlant's simulated response
// instead of real encoder readings. This isolates "is ROS2 sending sane
// commands and is the STM32 responding sensibly" from "does the physical
// arm move correctly" -- confirm this before ever pointing Main.lf at real
// hardware for the first time with a new controller.
//
// Build (needs the arm-none-eabi cross-compiler, same as Main.lf):
//   cd vel_control_mri_arm
//   lfc-dev src/Main_NoRobot.lf
// Flash the resulting Main_NoRobot.elf the same way Main.elf normally gets
// flashed, then run the usual ROS2 bringup against it.
//
// No real motor/encoder hardware is touched -- FakeMotorPlant.lf has no
// STM32/HAL dependencies (plain C, `#include <math.h>` only), so it cross-
// compiles cleanly here exactly as it does natively.
//
// Simplifications versus Main.lf, since there's no real robot to protect or
// read from:
//   - SEA deflection/velocity are NOT simulated -- State_Machine's
//     sea_encoder_positions/sea_encoder_velocities inputs are left
//     unconnected, so those StateMessage fields just stay at 0 (a fake rigid
//     joint, not a fake SEA spring).
//   - enable_motor_command/force_disable_motor_pins aren't wired to
//     anything -- FakeMotorPlant has no enable/disable input, so those
//     don't gate simulated motion here the way USM's real enable pin would.
//     Motion sanity-checking is still meaningful: it's driven by whatever
//     velocity State_Machine actually stages, which already zeroes on
//     not_receiving_error.
target C {
  single-threaded: true,
  platform: {
    name: "STM32",
    board: "F446RE"
  },
  files: ["src_c/motor_config.h",
          "src_c/sm_config.h",
          "src_c/common.h",
          "src_c/stm_comms.h", "src_c/stm_comms.c"],
  cmake-include: [
      "../src_c/stm_comms_cmake.cmake"]
}

import StateMachine from "lib/State_Machine.lf"
import UART_Handler from "lib/Drivers/UART.lf"
import Small_DeltaP_Controller_Bank from "lib/Drivers/SmallDeltaPControl/Small_DeltaP_Controller_Bank.lf"
import FakeMotorPlant from "lib/Helpers/FakeMotorPlant.lf"

preamble {=
  #include <stdio.h>
  #include "stm32f4xx_hal.h"
  #include "main.h"

  #include "stm_comms.h"

  extern UART_HandleTypeDef huart2;

  =}

main reactor {
  preamble {=

    extern UART_HandleTypeDef huart1;
    extern UART_HandleTypeDef huart3;
    extern UART_HandleTypeDef huart4;
    extern UART_HandleTypeDef huart5;

    extern TIM_HandleTypeDef htim6; // used for timing loops

    int stm32_init(void){
      HAL_Init();

      SystemClock_Config();

      MX_GPIO_Init();
      MX_DMA_Init();
      MX_UART4_Init();
      MX_USART1_UART_Init();
      MX_USART3_UART_Init();
      MX_USART6_UART_Init();
      MX_TIM3_Init();
      MX_TIM4_Init();
      MX_TIM6_Init();
      HAL_TIM_Base_Start(&htim6);
      MX_RTC_Init();
      MX_USART2_UART_Init();

      printf("\r\n");
      printf("~~~ STM32 START (NO ROBOT -- FakeMotorPlant comms test) ~~~ \r\n");
      printf("\r\n");

      return 0;
    }

    // Only UART4 (DMA_UART, UART_Handler's real ROS2 link) is dispatched --
    // unlike Main.lf, there's no QDEC/USM here to route USART1/USART3 to, so
    // routing those cases would be an undefined-symbol link error.
    void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart) {
      if (huart->Instance == UART4) { // UART4 // DMA_UART
        HAL_UART_RxCallback_DMA();
      }
    }

    // UART_Handler.lf's own preamble unconditionally dispatches USART3's
    // idle-DMA event to this function (normally defined by Encoder.lf, for
    // SEA/USM burst reception) -- stubbed here since this harness has no
    // QDEC instance to provide the real one.
    void HAL_UART_RxEventCallback3(UART_HandleTypeDef *huart, uint16_t Size) {
      (void) huart;
      (void) Size;
    }

    void HAL_UART_TxCpltCallback(UART_HandleTypeDef *huart) {
      (void) huart;
    }

    int hal_timer = 0;
  =}

  uart = new UART_Handler(transmit_period = 10 ms, receive_period = 10 ms)
  state_machine = new StateMachine(motor_command_period = 10 ms, update_state_message_period = 10 ms)
  deltap_bank = new Small_DeltaP_Controller_Bank()
  plant = new[7] FakeMotorPlant()

  // uart
  uart.cmd_msg -> state_machine.command_message
  uart.not_receiving_error -> state_machine.not_receiving_error

  state_machine.state_message -> uart.state_msg after 0;

  // controller <-> fake plant, in place of usm/qdec
  state_machine.commanded_motor_velocities -> deltap_bank.command_velocity_input
  state_machine.commanded_position_deltas -> deltap_bank.remaining_error_input
  deltap_bank.command_velocity_output -> plant.command_velocity

  plant.real_velocity -> state_machine.motor_encoder_velocities
  plant.position -> state_machine.motor_encoder_positions

  reaction(startup) {=
    stm32_init();
    hal_timer = HAL_GetTick();
  =}

}
