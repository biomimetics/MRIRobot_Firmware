// CSV-logging variant of Main_Test_SVC.lf for plotting Small_Velocity_
// Controller's behavior. Runs natively (no STM32 hardware/cross-compiler
// needed), drives a single controller instance with the same slow
// triangle-wave velocity trajectory as Main_Test_SVC.lf, feeds its output
// into a FakeMotorPlant (a simulated open-loop motor standing in for the
// real, encoder-less USM hardware), and logs every sample -- desired/
// commanded/real velocity, simulated position, motionDebt, and mode -- to a
// CSV via CsvLogger. Plot the result with scripts/plot_svc_test.py.
//
// ---- Quickstart ----
//   1. In src_c/pulse_mpc.h, set `#define PRINT_SVC 1` (see Note below).
//   2. cd vel_control_mri_arm
//   3. lfc-dev src/Main_Test_SVC_Csv.lf      # build (~10-20s)
//   4. ./bin/Main_Test_SVC_Csv               # run (real time << 30s logical,
//                                            # since target has fast: true)
//   5. python3 scripts/plot_svc_test.py      # opens a 3-panel plot window
//   6. Revert PRINT_SVC to 0 in src_c/pulse_mpc.h before committing/flashing.
//
// The run writes csv_data/svc_test_log.csv (created relative to whatever
// directory you invoke ./bin/Main_Test_SVC_Csv from -- run it from
// vel_control_mri_arm/ as above) with columns: time_s, desired_velocity,
// command_velocity, motion_debt, pass_through, state,
// filtered_velocity_magnitude, filtered_velocity, real_velocity, position
// (see CsvLogger.lf). scripts/plot_svc_test.py reads that same path by
// default; pass a different path as its first CLI argument to plot a run
// you saved elsewhere.
//
// Note: PRINT_SVC must be set to 1 in src_c/pulse_mpc.h at *build* time for
// debug_info (and therefore this CSV) to see anything real -- debug_info is
// only ever populated/emitted under that flag (see
// Small_Velocity_Controller.lf's control_tick reaction). If you forget,
// this will still build and run fine, just with the motionDebt/pass_through/
// state columns all reading 0 all the way through. Remember to flip it back
// to 0 before flashing production firmware, since it also enables
// Small_Velocity_Controller_Bank.lf's periodic UART printout.
target C {
  fast: true,
  timeout: 30 s
}

// No `platform` override here -- same reasoning as Main_Test_SVC.lf: this
// harness runs natively on the dev machine, not the STM32.
import Small_Velocity_Controller from "lib/SmallVelocityControl/Small_Velocity_Controller.lf"
import VelocitySignalGenerator from "lib/Helpers/VelocitySignalGenerator.lf"
import FakeMotorPlant from "lib/Helpers/FakeMotorPlant.lf"
import CsvLogger from "lib/Helpers/CsvLogger.lf"

main reactor {
  gen = new VelocitySignalGenerator()
  svc = new Small_Velocity_Controller()
  plant = new FakeMotorPlant()
  logger = new CsvLogger()

  gen.command_velocity -> svc.command_velocity_input
  svc.command_velocity_output -> plant.command_velocity
  svc.debug_info -> logger.debug_info
  plant.real_velocity -> logger.real_velocity
  plant.position -> logger.position
}
