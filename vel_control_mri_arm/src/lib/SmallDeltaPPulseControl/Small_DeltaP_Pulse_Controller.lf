target C {
  single-threaded: true,
  platform: {
    name: "stm32",
    board: "F446RE"
  },
  files: [
    "../../../src_c/pulse_motor_model.h", "../../../src_c/pulse_motor_model.c",
    "../../../src_c/gaussian_motion.h", "../../../src_c/gaussian_motion.c",
    "../../../src_c/stats.h", "../../../src_c/stats.c",
    "../../../src_c/small_deltap_pulse_controller.h", "../../../src_c/small_deltap_pulse_controller.c"
  ],
  cmake-include: [
    "../../../src_c/pulse_motor_model_cmake.cmake",
    "../../../src_c/gaussian_motion_cmake.cmake",
    "../../../src_c/stats_cmake.cmake",
    "../../../src_c/small_deltap_pulse_controller_cmake.cmake"
  ]
}

// Single-channel delta-position pulse controller. Sits inside
// Small_DeltaP_Pulse_Controller_Bank.lf, one instance per joint. Like
// Small_DeltaP_MPC_Controller.lf, replaces Small_Velocity_Controller.lf's
// motion-debt design (see

preamble {=
  #include "pulse_motor_model.h"
  #include "gaussian_motion.h"
  #include "small_deltap_pulse_controller.h"
  #include <math.h>
  #include <stdio.h>

  // Nanoseconds -> seconds, for converting LF instant_t/interval_t deltas
  // into the plain float seconds this controller's math works in.
  #define NS_TO_S 1e-9f
=}

// model_ starts from pulse_motor_model.h's shared INITIAL_MOTOR_MODEL
// (see reaction(startup) below) rather than its own constructor
// parameters -- keeps this controller, PulseMotorModelEstimator.lf, and any
// future reactor starting from exactly the same initial belief about the
// motor. Remaining constructor parameters below are this controller's own
// planning tuning, not part of PulseMotorModel.
reactor Small_DeltaP_Pulse_Controller(
  control_period: time = 5 ms,
  max_overshoot_probability: float = 0.02, // unitless 0..1, P(T <= pulse duration) bound the planner must respect -- TODO: characterize
  convergenceLimit_initial: float = 0.034906584, // rad (~2 deg), 
  remaining_error_start_threshold: float = 0.5, // rad, first part of AND statement to trigger pulses
  command_velocity_start_threshold: float = 0.4 // rad/s, second part of AND statement to trigger pulses
) {
  input command_velocity_input: float
  input remaining_error_input: float

  // Updated PulseMotorModel from an (as yet unbuilt) external parameter
  // estimator, which would compare planned pulses against encoder/state-
  // estimator feedback. Not applied immediately on arrival -- see
  // pending_model_update_/has_pending_model_update_ below and the
  // application point in control_tick -- to avoid changing V_min_cmd/gain/
  // V_variance/etc. out from under a pulse that's already mid-flight.
  input motor_model_update_input: PulseMotorModel

  input do_single_pulse_command: bool

  output command_velocity_output: float

  // Which MotorState this instance is currently in (STOPPED/STARTING/
  // RUNNING/STOPPING), for an external reactor (e.g. the parameter
  // estimator above) that needs to know when it's safe to attribute
  // encoder motion to a specific commanded pulse. Set at the end of
  // control_tick below, every tick.
  output motor_state_output: MotorState

  // The pulse currently committed to (valid from MOTOR_STARTING through
  // MOTOR_STOPPING; holds the last-run pulse while MOTOR_STOPPED, since
  // plannedPulse is only overwritten by PulseMotorModel_StartPulse) -- for
  // an external reactor (e.g. the parameter estimator above) that needs to
  // know what motion to expect out of a specific commanded pulse, paired
  // with motor_state_output above to know when that pulse is actually
  // in flight. Unlike debug_info below, set unconditionally every tick --
  // this is a normal signal an estimator depends on, not a diagnostics-only
  // dump gated behind a compile flag.
  output planned_pulse_output: PulseCommand

  // Just passThrough_ below (see its comment) put on the wire
  // unconditionally, instead of folded into debug_info -- which only ever
  // gets lf_set under PRINT_DPULSE/PRINT_DPULSE_DEBUG (see control_tick) --
  // so an external reactor (e.g. a command-bias estimator comparing
  // command_velocity_output against measured velocity) can gate on "this
  // sample is a clean commanded-vs-actual comparison, not a pulse in
  // flight" without needing those debug prints enabled. passThrough_ is
  // only ever reassigned inside the MOTOR_STOPPED decision block, so it
  // already reads false for the whole MOTOR_STARTING/RUNNING/STOPPING
  // duration of any pulse -- no extra state-machine check needed here.
  output is_passthrough_output: bool

  // True from the tick a single-pulse command (do_single_pulse_command)
  // actually starts a pulse through the tick it lands back in MOTOR_STOPPED
  // -- see running_single_pulse_command_'s comment below. For an external
  // reactor (the bank, then StateMachine, then the ROS host) that needs to
  // know when this joint's requested single pulse has finished.
  output running_single_pulse_command: bool

  // Diagnostics only -- only populated when PRINT_DPULSE or PRINT_DPULSE_DEBUG
  // is enabled (small_deltap_pulse_controller.h), same convention as
  // DposPulseMPCDebugInfo/PRINT_DPOS. For test harnesses/CSV logging (see
  // Main_Test_DeltaP_Pulse_Dwell.lf) and, via PRINT_DPULSE_DEBUG, for live
  // on-hardware printf debugging (see Small_DeltaP_Pulse_Controller_Bank.lf).
  output debug_info: SmallDeltaPPulseControllerDebugInfo

  state model_: PulseMotorModel
  state pulse_state_: PulseMotorState
  state desired_velocity_: float = 0.0
  state remaining_error_: float = 0.0
  state last_decide_time_: time = 0

  // amount of remaining position error we want to hit before we give up normal velocity control
  state remaining_error_start_threshold_: float = 0.0

  // the 'floor' of the magnitude of the command velocity before we start to consider giving up on velocity control
  state command_velocity_start_threshold_: float = 0.0

  // Overshoot-probability bound PulseMotorModel_PlanPulseWithOvershootBound
  // must keep the pulse duration under (model_.V_real, set in
  // reaction(startup) below, supplies the expected-velocity side of that
  // bound -- see pulse_motor_model.h).
  state max_overshoot_probability_: float = 0.0

  // rad -- below this, remaining_error_ is treated as converged and no
  // pulse is planned for it (control_tick below) -- see the constructor
  // parameter of the same name.
  state convergenceLimit_: float = 0.0

  // Latches the latest motor_model_update_input until it's safe to apply --
  // control_tick below only ever applies it while pulse_state_.state ==
  // MOTOR_STOPPED, so a model update can't land mid-pulse (STARTING/
  // RUNNING/STOPPING) and change what a pulse already committed to is
  // assumed to do partway through it.
  state pending_model_update_: PulseMotorModel
  state has_pending_model_update_: bool = false

  // true if the last MOTOR_STOPPED decision chose ordinary pass-through
  // control, false if pulsing mode is engaged (whether or not a pulse was
  // actually worth starting) -- for telemetry only (debug_info below),
  // mirrors DposPulseMPC's field of the same name.
  state passThrough_: bool = true

  // true once the last MOTOR_STOPPED decision found |remaining_error_|
  // already at/below convergenceLimit_ and gave up planning a pulse for it
  // -- for telemetry only (debug_info below), same role as passThrough_.
  // Combined with passThrough_: passThrough_ == true means this instance
  // isn't pulse-planning because velocity demand is driving it directly;
  // passThrough_ == false && converged_ == true means it isn't pulse-
  // planning because it's already close enough; passThrough_ == false &&
  // converged_ == false means it is actively planning/running pulses.
  state converged_: bool = false

  state do_single_pulse_command_: bool = false
  state running_single_pulse_command_: bool = false

  timer control_tick(0, control_period)

  reaction(startup) {=
    printf("[STARTUP] Small_DeltaP_Pulse_Controller: entering startup\r\n");
    self->model_ = INITIAL_MOTOR_MODEL;

    self->pulse_state_.state = MOTOR_STOPPED;
    self->pulse_state_.dir = 1.0f;
    self->pulse_state_.stateTimer = 0.0f;
    self->pulse_state_.pulseTimer = 0.0f;
    self->pulse_state_.plannedPulse.dir = 1.0f;
    self->pulse_state_.plannedPulse.run_duration = 0.0f;
    self->pulse_state_.commandVelocity = 0.0f;

    self->max_overshoot_probability_ = self->max_overshoot_probability;
    self->convergenceLimit_ = self->convergenceLimit_initial;

    self->last_decide_time_ = lf_time_physical();

    self->remaining_error_start_threshold_ = self->remaining_error_start_threshold;
    self->command_velocity_start_threshold_ = self->command_velocity_start_threshold;
    printf("[STARTUP] Small_DeltaP_Pulse_Controller: exiting startup\r\n");
  =}

  // Thin cache-only reactions: just copy incoming values into state. No FSM
  // logic here -- that all lives in the control_tick reaction below.
  reaction(command_velocity_input) {=
    self->desired_velocity_ = command_velocity_input->value;
  =}

  reaction(remaining_error_input) {=
    self->remaining_error_ = remaining_error_input->value;
  =}

  reaction(do_single_pulse_command) {=
    self->do_single_pulse_command_ = do_single_pulse_command->value;
  =}

  // Thin cache-only reaction, same as the two above -- just latches the
  // update. Applying it is control_tick's job, gated on MOTOR_STOPPED --
  // see pending_model_update_'s comment.
  reaction(motor_model_update_input) {=
    self->pending_model_update_ = motor_model_update_input->value;
    self->has_pending_model_update_ = true;
  =}

  // Runs the pulse-planning/FSM update at control_period cadence,
  // independent of when new setpoints arrive from upstream. As simple as
  // possible: every check below reads the live desired_velocity_/
  // remaining_error_ values directly, no EMA smoothing or extra state to
  // track why a decision was made -- compute RUNNING's early-exit
  // condition, advance the FSM, then (only at MOTOR_STOPPED) arbitrate
  // pass-through vs. pulsing and plan/start a pulse -- see that function's
  // comment for why mode arbitration has to be re-decided at every
  // MOTOR_STOPPED rather than fixed once.
  reaction(control_tick) -> command_velocity_output, motor_state_output, planned_pulse_output, is_passthrough_output, running_single_pulse_command, debug_info {=
    // Physical, not logical, time: dt here integrates the pulse FSM's
    // real-world timers (T_start/T_stop/pulseTimer against actual hardware
    // elapsed time), so it should track wall-clock time actually elapsed
    // between control_tick firings, not this reactor's logical tag --
    // those can diverge under scheduling jitter/load on real hardware.
    instant_t now = lf_time_physical();
    float dt = (float)(now - self->last_decide_time_) * NS_TO_S;
    self->last_decide_time_ = now;
    if (dt < 0.0f) dt = 0.0f; // defensive; physical time should be monotonic on this platform

    // stop_early: cut a RUNNING pulse short if EITHER demand has clearly
    // moved back into pass-through range, OR remaining_error_'s sign no
    // longer matches the latched pulse direction (target moved past/
    // reversed relative to what this pulse was planned against) -- same two
    // conditions as DposPulseMPC_Update's RUNNING checks, keyed to
    // remaining_error_ rather than desired_velocity_ for the second one:
    // desired_velocity_ legitimately sits near zero throughout pulsing.
    bool stop_early = false;
    if (self->pulse_state_.state == MOTOR_RUNNING) {
      if (fabsf(self->desired_velocity_) >= self->model_.V_min_cmd) {
        stop_early = true;
      } else if (sign_f(self->remaining_error_) != self->pulse_state_.dir) {
        stop_early = true;
      }
    }

    // Snapshot before Advance so the STOPPED-decision block below can tell
    // "already stopped last tick" apart from "just landed on STOPPED this
    // tick" -- see that block's guard for why the distinction matters.
    MotorState state_before_advance = self->pulse_state_.state;

    PulseMotorModel_Advance(&self->pulse_state_, &self->model_, dt, stop_early);

    // if we just stopped
    if (self->pulse_state_.state == MOTOR_STOPPED && state_before_advance == MOTOR_STOPPING){
      // if we were running the single pulse command request, release the flags that forces the pulse plan to trigger.
      if (self->running_single_pulse_command_){
        self->running_single_pulse_command_ = false;
        self->do_single_pulse_command_ = false;
      }
    }

    // Gated on state_before_advance == MOTOR_STOPPED too, not just the
    // post-Advance state: without that, a STOPPING -> STOPPED transition
    // that Advance makes THIS tick could fall straight through into
    // PulseMotorModel_StartPulse below and re-arm MOTOR_STARTING before
    // lf_set(motor_state_output, ...) ever runs -- collapsing STOPPED ->
    // STARTING into a single tick and never actually putting MOTOR_STOPPED
    // on the wire at all. Gating this way costs at most one extra
    // control_period of dwell time in MOTOR_STOPPED before the next pulse
    // starts, in exchange for guaranteeing every external observer (e.g.
    // PulseMotorModelEstimator.lf) gets to see MOTOR_STOPPED for at least
    // one tick.
    if (self->pulse_state_.state == MOTOR_STOPPED && state_before_advance == MOTOR_STOPPED) {
      // Only safe to apply a pending model update here -- MOTOR_STOPPED,
      if (self->has_pending_model_update_) {
        self->model_ = self->pending_model_update_;
        self->has_pending_model_update_ = false;
      }

      // if we have a command request to do a pulse command outside of the normal criteria for when we start them
      if (self->do_single_pulse_command_){
        self->passThrough_ = false;
        self->converged_ = false;

        PulseCommand pulse = PulseMotorModel_PlanPulseWithOvershootBound(&self->model_, self->remaining_error_, self->max_overshoot_probability_);
        PulseMotorModel_StartPulse(&self->pulse_state_, &self->model_, pulse);
        self->running_single_pulse_command_ = true;
      }
      else if ((fabsf(self->desired_velocity_) >= self->command_velocity_start_threshold_) || (fabsf(self->remaining_error_) >= self->remaining_error_start_threshold_)) {
        // if the velocity is greater than the floor or the remaining_error is greater than the floor, just let it pass through
        self->passThrough_ = true;
        self->converged_ = false;
        self->pulse_state_.commandVelocity = self->desired_velocity_;
      } else if (fabsf(self->remaining_error_) <= self->convergenceLimit_ || self->desired_velocity_ == 0.0f) {
        // Already converged, or no velocity demand at all -- don't bother
        // planning a pulse for it (a zero desired_velocity_ means nothing
        // upstream is actively asking this joint to move right now).
        self->passThrough_ = false;
        self->converged_ = true;
        self->pulse_state_.commandVelocity = 0.0f;
      }
      else { // if we're not in passthrough range and not converged, setup the next pulse and start it
        self->passThrough_ = false;
        self->converged_ = false;

        PulseCommand pulse = PulseMotorModel_PlanPulseWithOvershootBound(&self->model_, self->remaining_error_, self->max_overshoot_probability_);
        PulseMotorModel_StartPulse(&self->pulse_state_, &self->model_, pulse);
      }
    }
    // MOTOR_STARTING / MOTOR_RUNNING (still mid-pulse) / MOTOR_STOPPING: no
    // decision here; commandVelocity already holds whatever
    // PulseMotorModel_StartPulse/PulseMotorModel_Advance set.

    lf_set(command_velocity_output, self->pulse_state_.commandVelocity);
    lf_set(motor_state_output, self->pulse_state_.state);
    lf_set(planned_pulse_output, self->pulse_state_.plannedPulse);
    lf_set(is_passthrough_output, self->passThrough_);
    lf_set(running_single_pulse_command, self->running_single_pulse_command_);

#if PRINT_DPULSE || PRINT_DPULSE_DEBUG
    SmallDeltaPPulseControllerDebugInfo info;
    info.state = self->pulse_state_.state;
    info.passThrough = self->passThrough_;
    info.converged = self->converged_;
    info.remainingError = self->remaining_error_;
    info.plannedPulse = self->pulse_state_.plannedPulse;
    info.commandVelocity = self->pulse_state_.commandVelocity;
    lf_set(debug_info, info);
#endif
  =}
}
