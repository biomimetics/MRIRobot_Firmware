target C {
  single-threaded: true,
  platform: {
    name: "stm32",
    board: "F446RE"
  },
  files: ["../../../src_c/pulse_mpc.h", "../../../src_c/pulse_mpc.c"],
  cmake-include: ["../../../src_c/pulse_mpc_cmake.cmake"]
}

import Small_Velocity_Controller from "Small_Velocity_Controller.lf"

// Top-level preamble so SVCDebugInfo is visible where the print reaction
// below reads controllers[i].debug_info->value -- same reasoning as
// Small_Velocity_Controller.lf's own top-level preamble.
preamble {=
  #include "pulse_mpc.h"
=}

// 7-dof wrapper that sits between StateMachine.lf and USM.lf, routing velocity
// signals to a bank of single-channel Small_Velocity_Controller instances.
// Motor enable/disable does NOT route through here -- Main.lf wires
// State_Machine's enable_motor_command directly to USM instead, since
// coupling it to this controller's own bang-bang start/stop cycling caused
// direction-reversal failures downstream (see Small_Velocity_Controller.lf).
reactor Small_Velocity_Controller_Bank(print_period: time = 250 ms) {
  input[7] command_velocity_input: float

  output[7] command_velocity_output: float

  state last_print_time_: time = 0

  controllers = new[7] Small_Velocity_Controller()

  command_velocity_input -> controllers.command_velocity_input

  controllers.command_velocity_output -> command_velocity_output

  // Prints the status of all 7 Small_Velocity_Controller instances together,
  // at print_period cadence, when PRINT_SVC is enabled (pulse_mpc.h). Only
  // fires at all when PRINT_SVC is set, since debug_info is only ever
  // lf_set under that same flag (see Small_Velocity_Controller.lf).
  reaction(controllers.debug_info) {=
#if PRINT_SVC
    instant_t now = lf_time_logical();
    if ((now - self->last_print_time_) < self->print_period) {
      return;
    }
    self->last_print_time_ = now;

    printf("\r\n--- SVC status ---\r\n");
    for (int i = 0; i < controllers_width; i++) {
      PulseMPC_PrintDebugInfo(i, controllers[i].debug_info->value);
    }
#endif
  =}
}
