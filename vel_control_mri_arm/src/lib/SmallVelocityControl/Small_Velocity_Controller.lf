target C {
  single-threaded: true,
  platform: {
    name: "stm32",
    board: "F446RE"
  },
  files: [
    "../../../src_c/pulse_mpc.h", "../../../src_c/pulse_mpc.c",
    "../../../src_c/pulse_motor_model.h", "../../../src_c/pulse_motor_model.c"
  ],
  cmake-include: [
    "../../../src_c/pulse_mpc_cmake.cmake",
    "../../../src_c/pulse_motor_model_cmake.cmake"
  ]
}

// Single-channel hybrid velocity controller. Sits inside
// Small_Velocity_Controller_Bank.lf, one instance per joint. For ordinary
// velocity commands (|desiredVelocity| >= V_min), this passes the command
// straight through -- these ultrasonic motors are fine at normal speeds.
// Only once the commanded velocity drops below V_min (~10 deg/s, where
// these motors behave unpredictably under continuous commands) does it
// engage an open-loop Finite-Control-Set MPC (FCS-MPC) that bang-bangs the
// motor between 0 and V_min, using a motion-debt accumulator to track the
// desired average velocity via pulse timing. No encoder feedback is used --
// the debt update is model-predicted (dir*gain*V_min while running, 0
// otherwise), since encoder signals aren't trusted yet and a higher-level
// ROS2 process already closes the loop on trajectory/fine-positioning.
// Adapted from the reference example in fcs_mpc_example.c (kept unmodified
// as a reference), with: hard-stop only (cuts velocity in the same instant,
// fixing a bug in the reference where STOP left velocity commanded until a
// delay elapsed), signed bidirectional direction handling, an open-loop
// motion-debt model in place of the reference's encoder-fed debt, and the
// pass-through/small-velocity hybrid behavior (see PulseMPC_Update in
// pulse_mpc.c for exactly how mode switching is decided and debounced).
//
// This reactor does NOT handle motor enable/disable -- that's wired
// directly from State_Machine.lf to USM.lf in Main.lf, bypassing this
// controller entirely. Toggling enable on/off in sync with small-velocity
// bang-bang pulsing turned out to cause direction-reversal failures
// downstream (root-caused via hardware testing); routing the safety-disable
// signal straight to USM avoids coupling it to this controller's own
// start/stop cycling.
//
// The FCS-MPC struct/enums/functions themselves live in src_c/pulse_mpc.h
// and src_c/pulse_mpc.c (pulled in via the target `files`/`cmake-include`
// properties, the same pattern Main.lf uses for stm_comms.c) rather than
// in this file's preamble -- putting the PulseMPC struct in a real header
// is what lets it be used as a `state` field type below, and the reactor
// stays a thin wrapper: I/O, timing, and per-instance state only.
//
// The #include below is a top-level (file-scope) preamble, not a
// reactor-scoped one -- a reactor-scoped preamble only lands in the
// generated .c file, never the self-struct header, so the PulseMPC type
// wouldn't be visible where `state controller_: PulseMPC` needs it.
// Top-level, it's safe even if duplicated across multiple generated
// headers (as LF does for any file that imports this reactor) because
// it's just an #include, deduplicated by pulse_mpc.h's own include guard --
// matching the same pattern State_Machine.lf uses for its stm_comms.h
// include.
preamble {=
  #include "pulse_mpc.h"

  // Nanoseconds -> seconds, for converting LF instant_t/interval_t deltas
  // into the plain float seconds PulseMPC's math works in.
  #define NS_TO_S 1e-9f
=}

// Constructor parameters below are the initial-guess motor model / MPC
// tuning values, all placeholders pending real bench characterization (see
// each parameter's comment). Exposing them as reactor parameters (rather
// than hardcoding in `startup`) means a future per-joint tuning pass or a
// live parameter estimator can override them per bank instance without
// touching this file.
reactor Small_Velocity_Controller(
  control_period: time = 1 ms,
  V_min_initial: float = 0.2,        // rad/s, 0.1745 rad/s = ~10 deg/s -- TODO: characterize
  gain_initial: float = 0.9,            // unitless 0..1 -- TODO: characterize
  T_start_initial: time = 25 ms,       // startup command delay -- TODO: characterize further
  T_stop_initial: time = 1 ms,         // hard-stop settle time, datasheet value, likely optimistic
  minimumPulseWidth_initial: time = 20 ms, // hysteresis guard before STOP eligible -- TODO: characterize
  W_debt_initial: float = 1.0,          // MPC cost weight -- TODO: characterize
  W_switch_initial: float = 0.05,       // MPC cost weight -- TODO: characterize.
                                         // Must satisfy W_debt*gain*V_min*(H-T_start) > W_switch
                                         // or START will never beat IDLE once debt is large,
                                         // regardless of how large debt grows -- see PulseMPC_EvaluateCost's
                                         // ACTION_START case.
  W_pulse_initial: float = 0.001,        // MPC cost weight -- TODO: characterize
  H_initial: time = 300 ms,             // decision lookahead horizon -- TODO: characterize.
                                         // See W_switch_initial's comment: this must stay large enough,
                                         // relative to T_start_initial and W_switch_initial, that starting
                                         // a pulse is ever worth it.
  filterAlpha_initial: float = 0.1,     // weight on newest sample in the pass-through/
                                         // small-velocity mode filter (0..1); smaller is
                                         // smoother/slower to react -- TODO: characterize
  debtDeadband_initial: float = 0.005    // rad/s -- desiredVelocity magnitudes below this
                                         // don't contribute to motionDebt at all, so command
                                         // noise/jitter near zero can't slowly accumulate into
                                         // a debt that eventually forces a spurious pulse.
                                         // Kept very small by default -- TODO: characterize
) {
  input command_velocity_input: float

  output command_velocity_output: float
  output debug_info: SVCDebugInfo // only set when PRINT_SVC is enabled -- see pulse_mpc.h

  state controller_: PulseMPC
  state desired_velocity_: float = 0.0
  state last_decide_time_: time = 0

  timer control_tick(0, control_period)

  reaction(startup) {=
    self->controller_.model.V_min = self->V_min_initial;
    self->controller_.model.gain = self->gain_initial;
    self->controller_.model.T_start = (float) self->T_start_initial * NS_TO_S;
    self->controller_.model.T_stop = (float) self->T_stop_initial * NS_TO_S;
    self->controller_.model.minimumPulseWidth = (float) self->minimumPulseWidth_initial * NS_TO_S;

    self->controller_.W_debt = self->W_debt_initial;
    self->controller_.W_switch = self->W_switch_initial;
    self->controller_.W_pulse = self->W_pulse_initial;
    self->controller_.H = (float) self->H_initial * NS_TO_S;
    self->controller_.filterAlpha = self->filterAlpha_initial;
    self->controller_.debtDeadband = self->debtDeadband_initial;

    // Guards against a mistuned W_switch/W_debt/H/T_start combination
    // structurally preventing the motor from ever starting -- see
    // PulseMPC_ValidateWeights in pulse_mpc.c for the exact inequality and
    // why this specific failure mode is otherwise silent (motionDebt just
    // grows without bound while commandVelocity stays at 0 forever).
    PulseMPC_ValidateWeights(&self->controller_);

    self->controller_.state = MOTOR_STOPPED;
    self->controller_.dir = 1.0f;
    self->controller_.stateTimer = 0.0f;
    self->controller_.pulseTimer = 0.0f;
    self->controller_.motionDebt = 0.0f;
    self->controller_.commandVelocity = 0.0f;
    self->controller_.filteredVelocityMagnitude = 0.0f;
    self->controller_.filteredVelocity = 0.0f;

    self->last_decide_time_ = lf_time_logical();
  =}

  // Thin cache-only reaction: just copies the incoming value into state. No
  // debt accumulation, no FSM logic -- that all lives in the control_tick
  // reaction below.
  reaction(command_velocity_input) {=
    self->desired_velocity_ = command_velocity_input->value;
  =}

  // Runs debt accumulation AND the FSM/cost-based action selection
  // together, at control_period cadence, independent of when new setpoints
  // arrive from upstream.
  reaction(control_tick) -> command_velocity_output, debug_info {=
    instant_t now = lf_time_logical();
    float dt = (float)(now - self->last_decide_time_) * NS_TO_S;
    self->last_decide_time_ = now;
    if (dt < 0.0f) dt = 0.0f; // defensive; logical time is monotonic

    PulseMPC_Update(&self->controller_, self->desired_velocity_, dt);

    lf_set(command_velocity_output, self->controller_.commandVelocity);

#if PRINT_SVC
    SVCDebugInfo info;
    PulseMPC_GetDebugInfo(&self->controller_, self->desired_velocity_, &info);
    lf_set(debug_info, info);
#endif
  =}
}
