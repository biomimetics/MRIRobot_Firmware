target C {
  single-threaded: true,
  platform: {
    name: "stm32",
    board: "F446RE"
  }
}

// Single-channel velocity controller. Sits inside Small_Velocity_Controller_Bank.lf,
// one instance per joint. Currently a stub that passes signals straight through --
// real control logic to be filled in later.
reactor Small_Velocity_Controller {
  input command_velocity_input: float
  input enable_motor_command_input: bool

  output command_velocity_output: float
  output enable_motor_command_output: bool

  reaction(command_velocity_input) -> command_velocity_output {=
    lf_set(command_velocity_output, command_velocity_input->value);
  =}

  reaction(enable_motor_command_input) -> enable_motor_command_output {=
    lf_set(enable_motor_command_output, enable_motor_command_input->value);
  =}
}
