target C

preamble {=
  #include "dpos_pulse_mpc.h"
  #include <stdio.h>
  #include <sys/stat.h>
=}

// CSV logger for Small_DeltaP_MPC_Controller test harnesses -- the delta-
// position analogue of CsvLogger.lf. Kept as a separate sibling reactor
// rather than generalizing CsvLogger.lf: keeps the two controllers' test
// harnesses fully decoupled (CsvLogger.lf/SVCDebugInfo stay SVC-only).
//
// Appends one CSV row per sample_period tick, combining a
// Small_DeltaP_MPC_Controller's debug_info (only populated when PRINT_DPOS is
// set to 1 in src_c/dpos_pulse_mpc.h) with a FakeMotorPlant's simulated
// real_velocity/position, so a run can be plotted afterward (see
// scripts/plot_deltap_test.py).
//
// target_position is optional -- leave it unconnected (as
// Main_Test_DeltaP_Csv.lf's PID-driven harness does, which has no signal
// generator to log a target from) and the column just reads 0 throughout.
// When it IS connected (Main_Test_DeltaP_Dwell.lf), log the real value
// directly rather than reconstructing it as position + remaining_error --
// remainingError goes stale during a RUNNING pulse (dpos_pulse_mpc.c only
// refreshes it at STOPPED, since pulses execute open-loop), so that
// reconstruction silently smears out exactly the flat dwell region a dwell
// test cares about.
//
// Relies on this program also importing Small_DeltaP_MPC_Controller.lf (whose
// target `files` property pulls in dpos_pulse_mpc.h/dpos_pulse_mpc.c) so
// that DposPulseMPCDebugInfo is visible here -- this reactor does not
// declare its own `files`/`cmake-include`.
//
// Each row is opened/appended/closed individually (fopen "a", not one
// handle held open for the whole run) so data already written survives even
// if the program's timeout kills it mid-run -- same pattern as CsvLogger.lf.
reactor DeltaPCsvLogger(
  sample_period: time = 1 ms,
  csv_path: string = "csv_data/deltap_test_log.csv"
) {
  input debug_info: DposPulseMPCDebugInfo
  input real_velocity: float
  input position: float
  input target_position: float

  state latest_debug_info_: DposPulseMPCDebugInfo
  state latest_real_velocity_: float = 0.0
  state latest_position_: float = 0.0
  state latest_target_position_: float = 0.0
  state row_count_: int = 0

  timer sample_tick(0, sample_period)

  reaction(startup) {=
    mkdir("csv_data", 0755); // no-op if it already exists

    FILE *fpt = fopen(self->csv_path, "w");
    fprintf(fpt,
        "time_s,remaining_error,command_velocity,pass_through,state,"
        "planned_dir,planned_run_duration,real_velocity,position,target_position\n");
    fclose(fpt);
  =}

  reaction(debug_info) {=
    self->latest_debug_info_ = debug_info->value;
  =}

  reaction(real_velocity) {=
    self->latest_real_velocity_ = real_velocity->value;
  =}

  reaction(position) {=
    self->latest_position_ = position->value;
  =}

  reaction(target_position) {=
    self->latest_target_position_ = target_position->value;
  =}

  reaction(sample_tick) {=
    double now_s = (double) lf_time_logical() * 1e-9;
    DposPulseMPCDebugInfo *d = &self->latest_debug_info_;

    FILE *fpt = fopen(self->csv_path, "a");
    fprintf(fpt, "%f,%f,%f,%d,%d,%f,%f,%f,%f,%f\n",
        now_s,
        (double) d->remainingError,
        (double) d->commandVelocity,
        d->passThrough,
        (int) d->state,
        (double) d->plannedPulse.dir,
        (double) d->plannedPulse.run_duration,
        (double) self->latest_real_velocity_,
        (double) self->latest_position_,
        (double) self->latest_target_position_);
    fclose(fpt);

    self->row_count_++;
  =}

  reaction(shutdown) {=
    printf("[DeltaPCsvLogger] wrote %d rows to %s\n", self->row_count_, self->csv_path);
  =}
}
