target C

preamble {=
  #include "pulse_mpc.h"
  #include <stdio.h>
  #include <sys/stat.h>
=}

// Appends one CSV row per sample_period tick, combining a
// Small_Velocity_Controller's debug_info (only populated when PRINT_SVC is
// set to 1 in src_c/pulse_mpc.h -- see Small_Velocity_Controller.lf) with a
// FakeMotorPlant's simulated real_velocity/position, so a run can be
// plotted afterward (see scripts/plot_svc_test.py) instead of only eyeballed
// via rolling printf stats (compare TrackingLogger in Main_Test_SVC.lf).
//
// Relies on this program also importing Small_Velocity_Controller.lf
// (whose target `files` property pulls in pulse_mpc.h/pulse_mpc.c) so that
// SVCDebugInfo is visible here -- this reactor does not declare its own
// `files`/`cmake-include`.
//
// Each row is opened/appended/closed individually (fopen "a", not one
// handle held open for the whole run) so data already written survives even
// if the program's timeout kills it mid-run -- same pattern used by
// src_c/uart_comms_logger.c.
reactor CsvLogger(
  sample_period: time = 1 ms,
  csv_path: string = "csv_data/svc_test_log.csv"
) {
  input debug_info: SVCDebugInfo
  input real_velocity: float
  input position: float

  state latest_debug_info_: SVCDebugInfo
  state latest_real_velocity_: float = 0.0
  state latest_position_: float = 0.0
  state row_count_: int = 0

  timer sample_tick(0, sample_period)

  reaction(startup) {=
    mkdir("csv_data", 0755); // no-op if it already exists

    FILE *fpt = fopen(self->csv_path, "w");
    fprintf(fpt,
        "time_s,desired_velocity,command_velocity,motion_debt,pass_through,"
        "state,filtered_velocity_magnitude,filtered_velocity,real_velocity,position\n");
    fclose(fpt);
  =}

  reaction(debug_info) {=
    self->latest_debug_info_ = debug_info->value;
  =}

  reaction(real_velocity) {=
    self->latest_real_velocity_ = real_velocity->value;
  =}

  reaction(position) {=
    self->latest_position_ = position->value;
  =}

  reaction(sample_tick) {=
    double now_s = (double) lf_time_logical() * 1e-9;
    SVCDebugInfo *d = &self->latest_debug_info_;

    FILE *fpt = fopen(self->csv_path, "a");
    fprintf(fpt, "%f,%f,%f,%f,%d,%d,%f,%f,%f,%f\n",
        now_s,
        (double) d->desiredVelocity,
        (double) d->commandVelocity,
        (double) d->motionDebt,
        d->passThrough,
        (int) d->state,
        (double) d->filteredVelocityMagnitude,
        (double) d->filteredVelocity,
        (double) self->latest_real_velocity_,
        (double) self->latest_position_);
    fclose(fpt);

    self->row_count_++;
  =}

  reaction(shutdown) {=
    printf("[CsvLogger] wrote %d rows to %s\n", self->row_count_, self->csv_path);
  =}
}
