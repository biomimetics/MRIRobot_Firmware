target C {
  single-threaded: true,
  platform: {
    name: "STM32",
    board: "F446RE"
  }
  //files: ["/include_c/stm_comms.h", "/src_c/stm_comms.c"]
}

preamble{=
  #include "stm32f4xx_hal.h"
  #include "main.h"
  #include <stdio.h>
  #include <string.h>
  #include <stdlib.h>
  #include <ctype.h>

  #include "stm_comms.h"
  //#include "stm_comms.c"

  #include "common.h"


=}

reactor UART_Handler(transmit_period: time = 10 ms, receive_period: time = 10 ms){
    input state_msg: StateMessage
    output cmd_msg: CommandMessage

    output not_receiving_error: bool

    state state_msg_: StateMessage
    state cmd_msg_: CommandMessage

    state not_receiving_count: int = 0
    state not_receiving_count_max: int = 10

    // Scheduled from the DMA RX-complete ISR (see HAL_UART_RxCallback_DMA in
    // the preamble) the instant a command packet finishes arriving, so it is
    // decoded immediately instead of waiting up to receive_period for the
    // polling receive_timer below.
    physical action cmd_rx_action

    //timer transmit_timer(0 ms, transmit_period)
    // Watchdog only now (packet decode moved to reaction(cmd_rx_action)):
    // ticks up not_receiving_count so a stalled host link still trips
    // not_receiving_error even though nothing polls for packets anymore.
    timer receive_timer(0 ms, receive_period)

    preamble{=
        // ------
        // Init functions
        // ------

        // This UART line only ever carries CommandMessage packets (host ->
        // STM32; StateMessage is the other direction), so the fixed-size RX
        // below waits for exactly one CommandMessage-sized packet rather than
        // UART_BUFFER_SIZE (which is sized for the larger StateMessage and
        // would never arrive on this line -- see common.h's old USE_EX_DMA=1
        // comment for why that broke fixed-size reception before this fix).
        // TODO: revisit if/when packets on this line become variable-length;
        // this assumes every CommandMessage on the wire is the same size.
        #define COMMAND_PACKET_SIZE (COMMAND_MSG_SIZE + PACKET_OVERHEAD)

        // Reference to the cmd_rx_action physical action, stashed by the
        // startup reaction so the DMA RX-complete ISR can inject a "command
        // packet ready" event directly into the LF event queue (via
        // lf_schedule) instead of the reactor polling a flag every
        // receive_period. NULL until startup runs, so scheduling is guarded.
        // The ISR only schedules -- the packet is still decoded in
        // reaction(cmd_rx_action), i.e. in normal LF context, so no reactor
        // state is touched from interrupt context.
        static void* cmd_rx_action_ptr = NULL;

        uint8_t uart_rx_dma_buffer[UART_BUFFER_SIZE];
        uint8_t uart_rx_dma_buffer_copy[UART_BUFFER_SIZE];
        size_t uart_receive_size;

        uint8_t uart_tx_data_buffer[UART_BUFFER_SIZE];

        uint8_t uart_tx_dma_buffer[UART_BUFFER_SIZE];

        void HAL_UART_RxCallback_DMA(){

            //printf("In HAL_UART_RxCpltCallback, received some bytes.");
            uart_receive_size = (size_t)COMMAND_PACKET_SIZE; //(size_t)Size;

            memcpy(uart_rx_dma_buffer_copy, uart_rx_dma_buffer, COMMAND_PACKET_SIZE); // moves the data over to a buffer that's handled in the receive update

            // Re-arm reception first so the next packet can start landing while
            // this one is processed, then wake LF to decode it now.
            HAL_UART_Receive_DMA(&DMA_UART, uart_rx_dma_buffer, COMMAND_PACKET_SIZE);
            if (cmd_rx_action_ptr != NULL) {
                lf_schedule(cmd_rx_action_ptr, 0);
            }
        }

        // HAL_UARTEx_ReceiveToIdle_DMA funnels ALL idle-DMA UARTs through this
        // one weak global callback, not per-instance ones -- so any other
        // reactor using idle-DMA reception (currently Encoder.lf's SEA/USM
        // burst reception on huart3) has to be dispatched out of here by
        // huart->Instance, mirroring how Main.lf's HAL_UART_RxCpltCallback
        // already dispatches by instance for the non-idle DMA/IT callbacks.
        extern void HAL_UART_RxEventCallback3(UART_HandleTypeDef *huart, uint16_t Size);

        void HAL_UARTEx_RxEventCallback(UART_HandleTypeDef *huart, uint16_t Size){
            if (huart->Instance == USART3) {
                HAL_UART_RxEventCallback3(huart, Size);
                return;
            }

            uart_receive_size = (size_t)Size;
            memcpy(uart_rx_dma_buffer_copy, uart_rx_dma_buffer, uart_receive_size); // moves the data over to a buffer that's handled in the receive update
            HAL_UARTEx_ReceiveToIdle_DMA(&DMA_UART, uart_rx_dma_buffer, UART_BUFFER_SIZE);
            if (cmd_rx_action_ptr != NULL) {
                lf_schedule(cmd_rx_action_ptr, 0);
            }
        }
        
    =}

    // method to initiate dma receiving callback loop
    method receiveToIdle_DMA_Init(){=
        
        if (USE_EX_DMA){
            HAL_UARTEx_ReceiveToIdle_DMA(&DMA_UART, uart_rx_dma_buffer, UART_BUFFER_SIZE);
        }
        else{
            HAL_UART_Receive_DMA(&DMA_UART, uart_rx_dma_buffer, COMMAND_PACKET_SIZE);
        }
    =}

    reaction (startup) -> cmd_rx_action {=
        printf("[STARTUP] UART_Handler: entering startup\r\n");
        // Stash the action reference for the DMA RX-complete ISR BEFORE arming
        // reception, so the very first completed packet can be scheduled.
        cmd_rx_action_ptr = cmd_rx_action;
        receiveToIdle_DMA_Init();
        printf("UART has finished startup!\n");
        printf("[STARTUP] UART_Handler: exiting startup\r\n");
    =}

    reaction (state_msg){=
        //printf("In uarts's state_msg reaction...\n");
        self->state_msg_ = state_msg->value;

        // do write
        //print_state_message_int(&self->state_msg_);
        int data_buffer_len = encode_state_message_to_data_buffer(&self->state_msg_, uart_tx_data_buffer);

        int packet_len = build_packet(uart_tx_dma_buffer, PKT_TYPE_DATA, uart_tx_data_buffer, data_buffer_len);
        //int packet_len = data_buffer_len + 4;

        if (packet_len < 1){
            if (PRINT_UART) printf("Failed to build packet!");
        }
        else{
            HAL_UART_Transmit_DMA(&DMA_UART, uart_tx_dma_buffer, packet_len);
        }

    =}

    // Decodes a command packet the instant the DMA ISR schedules this action.
    // Reads the ISR-filled uart_rx_dma_buffer_copy/uart_receive_size (the
    // decode itself runs in normal LF context, not the ISR). A good packet
    // resets the not-receiving watchdog; the receive_timer below trips the
    // error if this stops firing.
    reaction (cmd_rx_action) -> cmd_msg, not_receiving_error{=
        int res = handle_command_message_packet(&self->cmd_msg_, uart_rx_dma_buffer_copy, uart_receive_size);
        //print_command_message_int(&self->cmd_msg_);
        if (res){
            lf_set(cmd_msg, self->cmd_msg_);

            self->not_receiving_count = 0;
            lf_set(not_receiving_error, false);
        }
        else{
            self->not_receiving_count++;
        }
    =}

    // Not-receiving watchdog. Ticks every receive_period; a successful decode
    // in reaction(cmd_rx_action) resets not_receiving_count, so this only
    // reaches the limit when packets have genuinely stopped arriving.
    reaction (receive_timer) -> not_receiving_error{=
        self->not_receiving_count++;

        if (self->not_receiving_count_max < self->not_receiving_count){
            if (PRINT_UART) printf("UART Handler not receiving new data!\n");
            self->not_receiving_count = 0;
            lf_set(not_receiving_error, true);
        }
    =}
}