target C {
  single-threaded: true,
  platform: {
    name: "stm32",
    board: "F446RE"
  }
}

// ===========================================================================
// USM_DAC -- DAC7578-driven replacement for USM.lf
// ===========================================================================
//
// This is a bench-test version of USM.lf that replaces the 7-channel
// TIM3/TIM4 PWM + RC filter analog reference with a DAC7578 8-channel
// 12-bit I2C DAC (Adafruit breakout). Background/protocol details are in
// ../../../dac_conversion_outline.md ("Alternative Implementation -- DAC7578
// via I2C1"); this header only covers what's specific to this reactor and
// this first bench-test wiring.
//
// Port-compatible with USM.lf (same speed / enable_motor_command /
// force_disable_motor_pins / commanded_duty_cycle signature) so it can be
// swapped in for USM in Main.lf ("usm = new USM()" -> "usm = new USM_DAC()")
// once the DAC is wired up. That swap is NOT part of this file -- Main.lf is
// untouched for now.
//
// ---------------------------------------------------------------------
// Why bit-banged I2C instead of the hardware I2C1 peripheral
// ---------------------------------------------------------------------
//
// Every GPIO pin on this STM32F446RE is already committed somewhere in the
// existing design (see STM_sdk/stm32cubemx_proj/sdk_gen_proj.ioc -- all 53
// usable pins are assigned) because the STM32 is soldered directly to this
// custom PCB. Every hardware I2C peripheral pin option collides with an
// existing PCB net:
//   I2C1: PB6/PB7 (TIM4 CH1/CH2, RC-filter inputs) or PB8/PB9 (TIM4 CH3 /
//         motor-3 enable)
//   I2C2: PB10/PB11 -- PB10 is motor-4 enable
//   I2C3: PA8/PC9 or PA8/PB4 -- PC9 and PB4 are TIM3 PWM pins
// Using any of those for I2C would mean the STM32 actively toggles a
// digital signal onto a pad that's also supposed to carry a clean DAC
// voltage into the RC filter for that channel -- a direct electrical
// conflict, not just a firmware conflict.
//
// Instead this reactor bit-bangs I2C in software on **PB11 (SCL)** and
// **PC12 (SDA)** -- both confirmed unused by anything in this firmware or
// the .ioc (see src_c/spi_availability_notes.md, which found the same two
// pins free during the AD5628/SPI investigation). Because nothing else is
// wired to those pads, all 7 of the old PWM pins (PB4/PB5/PB6/PB7/PB8/
// PC8/PC9) are then genuinely free for the DAC to drive without contention.
//
// ---------------------------------------------------------------------
// Wiring: STM32 <-> Adafruit DAC7578 breakout
// ---------------------------------------------------------------------
//
//   STM32 pin              Breakout pin   Note
//   ----------              ------------   ----
//   PB11 (bit-banged SCL)    SCL           onboard 10k pull-up to VCC, no
//                                          external pull-up added
//   PC12 (bit-banged SDA)    SDA           onboard 10k pull-up to VCC, no
//                                          external pull-up added
//   3.3V                     VCC           also sets DAC output range (0-3.3V)
//   GND                       GND
//   GND                       LDAC         tie low -> every write updates the
//                                          output immediately (cmd 0x3 below)
//   3.3V                     CLR           tie high -> disables hardware clear
//
//   Breakout ships with AD0 floating -> I2C address 0x4C (NOT the bare-chip
//   default 0x48). Solder the AD0 pad to GND if 0x48 is ever needed instead;
//   update DAC7578_I2C_ADDR_7BIT below to match.
//
// ---------------------------------------------------------------------
// Wiring: DAC outputs -> existing PCB (first-test-only routing)
// ---------------------------------------------------------------------
//
// The outline's end-state recommendation is to wire DAC0-DAC6 straight to
// the motor controllers' analog reference inputs, deleting the RC filters
// entirely. For this first bench test, instead patch DAC0-DAC6 into the
// SAME PCB pads the old TIM3/TIM4 PWM pins used to drive -- i.e. the RC
// filter *inputs* -- so the existing filter and existing wiring to the
// motor controllers are left completely alone:
//
//   DAC7578 channel   USM index   Old STM32 pin (now free, DAC feeds its pad)
//   ---------------   ---------   -------------------------------------------
//   DAC A (addr 0x0)  USM0        PB4  (was TIM3 CH1)
//   DAC B (addr 0x1)  USM1        PB5  (was TIM3 CH2)
//   DAC C (addr 0x2)  USM2        PC8  (was TIM3 CH3)
//   DAC D (addr 0x3)  USM3        PC9  (was TIM3 CH4)
//   DAC E (addr 0x4)  USM4        PB6  (was TIM4 CH1)
//   DAC F (addr 0x5)  USM5        PB7  (was TIM4 CH2)
//   DAC G (addr 0x6)  USM6        PB8  (was TIM4 CH3)
//   DAC H (addr 0x7)  unused      --
//
//   All 7 of these pins are now genuinely free on the STM32 side -- this
//   reactor's startup reaction explicitly reconfigures them to
//   GPIO_MODE_ANALOG (see release_old_pwm_pins() below) rather than leaving
//   them as push-pull timer outputs, so the STM32 doesn't fight the DAC's
//   injected voltage on those pads (see the ordering note further down).
//
//   Caveat: routing a DC-ish DAC output through the RC filter that used to
//   smooth PWM ripple adds that filter's settling lag to every step change.
//   That's fine for validating the concept; remove the filter from the
//   signal path once wiring goes direct to the motor controllers.
//
// ---------------------------------------------------------------------
// Global init ordering note
// ---------------------------------------------------------------------
//
// Main.lf's stm32_init() (called from Main's own reaction(startup)) still
// unconditionally calls the STM32CubeMX-generated MX_TIM3_Init()/
// MX_TIM4_Init() (see STM_sdk/Core/Src/tim.c), which configures PB4/PB5/
// PB6/PB7/PB8/PC8/PC9 as push-pull TIM3/TIM4 AF2 outputs at boot (channels
// not started, but still actively driven, not floating). This reactor's own
// reaction(startup) calls release_old_pwm_pins() to switch all 7 back to
// GPIO_MODE_ANALOG (high-Z) before the DAC drives them. This only works
// correctly because Main's reaction(startup) runs before contained
// reactors' reaction(startup) -- if that ordering ever changes, those pins
// could be left actively driven by the timer peripheral instead of
// released. No PCB pin relocation is required for PB11/PC12 -- they're
// spare pins already broken out on the existing header, not on the
// morpho-only connector.
//
// ===========================================================================

preamble {=
  #include "stm32f4xx_hal.h"
  #include <stdio.h>
  #include <stdlib.h>
  #include <math.h> // need for floating point abs, or fabsf()
  #include "motor_config.h"
  #include "common.h"

=}

reactor USM_DAC {
  input[7] speed: float
  input[7] enable_motor_command: bool
  input[7] force_disable_motor_pins: bool

  output[7] commanded_duty_cycle: float // only used for monitoring purposes

  state force_disable_motor_pins_: bool[7] = {false, false, false, false, false, false, false}
  state enable_motor_command_: bool[7] = {false, false, false, false, false, false, false}

  preamble {=

    // for debugging
    long reference_tick_usm_dac = 0; //HAL_GetTick();

    float apply_duty_cycle_limits(float duty_cycle){
      duty_cycle = fabsf(duty_cycle); // force it positive

      if (PRINT_USM)printf("Got duty cycle of %d%, or %d deg/s\r\n", ((int)(duty_cycle*100)), ((int) (duty_cycle * PWM_RPM_MAX * RPM_TO_DEG_PER_SEC)));

      if (USM_MAX_DUTY_CYCLE < duty_cycle){ // limit it to the max value
        if (PRINT_USM)printf("Hit max duty cycle! Setting to %d%\r\n", ((int)(USM_MAX_DUTY_CYCLE*100)));
        duty_cycle = USM_MAX_DUTY_CYCLE;
      }

      if (duty_cycle < USM_MIN_DUTY_CYCLE){ // limit it to the max value
        if (PRINT_USM)printf("Hit min duty cycle! Setting to %d%\r\n", 0);
        duty_cycle = 0.0;
      }
      return duty_cycle;
    }

    #define DAC7578_I2C_ADDR_7BIT    0x4C            // Adafruit breakout default (AD0 floating)
    // #define DAC7578_I2C_ADDR_7BIT 0x48             // use this instead if AD0 pad is soldered to GND
    #define DAC7578_CMD_WRITE_UPDATE 0x3           // stage + update this channel immediately
    #define DAC7578_CMD_RESET        0xF
    #define DAC7578_DAC_COUNTS       4095           // 12-bit full scale

    volatile float speed_[7] = {0, 0, 0, 0, 0, 0, 0}; // internal copy of speed, not a reactor state because is changed inplace with preamble functions
    volatile float usm_duty_cycle_[7] = {0, 0, 0, 0, 0, 0, 0}; // not a reactor state because is changed inplace with preamble functions

    volatile bool motor_directions_[7] = {true, true, true, true, true, true, true};

    // ---------------------------------------------------------------------
    // Bit-banged I2C on PB11 (SCL) / PC12 (SDA) -- see header comment for
    // why hardware I2C1 isn't used. Both lines are open-drain outputs;
    // "high" releases the line to the breakout's onboard pull-ups, "low"
    // actively pulls it down. ~100 kHz bit rate via a DWT cycle-counter delay.
    // ---------------------------------------------------------------------

    #define I2C_SCL_PORT GPIOB
    #define I2C_SCL_PIN  GPIO_PIN_11
    #define I2C_SDA_PORT GPIOC
    #define I2C_SDA_PIN  GPIO_PIN_12

    static void dwt_delay_init(void) {
      CoreDebug->DEMCR |= CoreDebug_DEMCR_TRCENA_Msk;
      DWT->CYCCNT = 0;
      DWT->CTRL |= DWT_CTRL_CYCCNTENA_Msk;
    }

    static inline void delay_us(uint32_t us) {
      uint32_t start = DWT->CYCCNT;
      uint32_t cycles = us * (SystemCoreClock / 1000000);
      while ((DWT->CYCCNT - start) < cycles);
    }

    static inline void i2c_bit_delay(void) { delay_us(5); } // ~100 kHz (10us period)

    static inline void i2c_scl_high(void) { HAL_GPIO_WritePin(I2C_SCL_PORT, I2C_SCL_PIN, GPIO_PIN_SET); }
    static inline void i2c_scl_low(void)  { HAL_GPIO_WritePin(I2C_SCL_PORT, I2C_SCL_PIN, GPIO_PIN_RESET); }
    static inline void i2c_sda_high(void) { HAL_GPIO_WritePin(I2C_SDA_PORT, I2C_SDA_PIN, GPIO_PIN_SET); }
    static inline void i2c_sda_low(void)  { HAL_GPIO_WritePin(I2C_SDA_PORT, I2C_SDA_PIN, GPIO_PIN_RESET); }

    static void I2C_Bitbang_Init(void) {
      GPIO_InitTypeDef GPIO_InitStruct = {0};
      __HAL_RCC_GPIOB_CLK_ENABLE();
      __HAL_RCC_GPIOC_CLK_ENABLE();

      GPIO_InitStruct.Mode  = GPIO_MODE_OUTPUT_OD; // open-drain, matches I2C bus behavior
      GPIO_InitStruct.Pull  = GPIO_NOPULL;          // breakout has onboard 10k pull-ups
      GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;

      GPIO_InitStruct.Pin = I2C_SCL_PIN;
      HAL_GPIO_Init(I2C_SCL_PORT, &GPIO_InitStruct);
      GPIO_InitStruct.Pin = I2C_SDA_PIN;
      HAL_GPIO_Init(I2C_SDA_PORT, &GPIO_InitStruct);

      i2c_sda_high();
      i2c_scl_high();

      dwt_delay_init();
    }

    static void I2C_Start(void) {
      i2c_sda_high();
      i2c_scl_high();
      i2c_bit_delay();
      i2c_sda_low();
      i2c_bit_delay();
      i2c_scl_low();
      i2c_bit_delay();
    }

    static void I2C_Stop(void) {
      i2c_sda_low();
      i2c_bit_delay();
      i2c_scl_high();
      i2c_bit_delay();
      i2c_sda_high();
      i2c_bit_delay();
    }

    /* Clocks out one byte MSB-first, returns true if the slave ACKed. Since
       SCL/SDA stay in GPIO_MODE_OUTPUT_OD, the input buffer still reads the
       actual pin state after releasing SDA high, so no mode switch is
       needed to sample the ACK bit. */
    static bool I2C_WriteByte(uint8_t byte) {
      for (int i = 0; i < 8; i++) {
        if (byte & 0x80) i2c_sda_high(); else i2c_sda_low();
        byte <<= 1;
        i2c_bit_delay();
        i2c_scl_high();
        i2c_bit_delay();
        i2c_scl_low();
        i2c_bit_delay();
      }
      i2c_sda_high(); // release SDA so the slave can pull it low for ACK
      i2c_bit_delay();
      i2c_scl_high();
      i2c_bit_delay();
      bool ack = (HAL_GPIO_ReadPin(I2C_SDA_PORT, I2C_SDA_PIN) == GPIO_PIN_RESET);
      i2c_scl_low();
      i2c_bit_delay();
      return ack;
    }

    /* Send one write transaction to a single DAC channel */
    void DAC7578_write(uint8_t channel, uint16_t value) {
      uint8_t addr_byte = (DAC7578_I2C_ADDR_7BIT << 1); // write bit = 0
      uint8_t ca_byte  = (DAC7578_CMD_WRITE_UPDATE << 4) | (channel & 0x0F);
      uint8_t msdb     = (value >> 4) & 0xFF;   // D11:D4
      uint8_t lsdb     = (value & 0x0F) << 4;   // D3:D0 in upper nibble

      I2C_Start();
      I2C_WriteByte(addr_byte);
      I2C_WriteByte(ca_byte);
      I2C_WriteByte(msdb);
      I2C_WriteByte(lsdb);
      I2C_Stop();
    }

    /* Replaces convert_duty_cycle_to_pwm_ccr() */
    uint16_t convert_duty_cycle_to_dac_counts(float duty_cycle){
      return (uint16_t)(duty_cycle * (float)DAC7578_DAC_COUNTS);
    }

    /* Replaces set_motor_pwm_registers() */
    void set_motor_dac_outputs(void) {
      for (int i = 0; i < 7; i++) {
        uint16_t counts = convert_duty_cycle_to_dac_counts(usm_duty_cycle_[i]);
        DAC7578_write(i, counts); // channel address i == USM index i, see channel map above
      }
    }

    /* Call once at startup after I2C_Bitbang_Init() */
    void DAC7578_init(void) {
      uint8_t addr_byte = (DAC7578_I2C_ADDR_7BIT << 1);
      I2C_Start();
      I2C_WriteByte(addr_byte);
      I2C_WriteByte(DAC7578_CMD_RESET << 4);
      I2C_WriteByte(0x00);
      I2C_Stop();
      set_motor_dac_outputs(); // set all outputs to 0
    }

    /* Old TIM3/TIM4 PWM pins, still configured push-pull AF2 by Main.lf's
       global MX_TIM3_Init()/MX_TIM4_Init() (see the "Global init ordering
       note" in the header comment). Switch them to GPIO_MODE_ANALOG
       (high-Z) so the STM32 doesn't fight the DAC's injected voltage on
       these pads. Must run after Main's stm32_init(). */
    static void release_old_pwm_pins(void) {
      GPIO_InitTypeDef GPIO_InitStruct = {0};
      GPIO_InitStruct.Mode = GPIO_MODE_ANALOG;
      GPIO_InitStruct.Pull = GPIO_NOPULL;

      GPIO_InitStruct.Pin = GPIO_PIN_4 | GPIO_PIN_5 | GPIO_PIN_6 | GPIO_PIN_7 | GPIO_PIN_8;
      HAL_GPIO_Init(GPIOB, &GPIO_InitStruct); // PB4, PB5, PB6, PB7, PB8

      GPIO_InitStruct.Pin = GPIO_PIN_8 | GPIO_PIN_9;
      HAL_GPIO_Init(GPIOC, &GPIO_InitStruct); // PC8, PC9
    }

    static void USM_GPIO_Init(void) {
      GPIO_InitTypeDef GPIO_InitStruct = {0};
      __HAL_RCC_GPIOB_CLK_ENABLE();
      __HAL_RCC_GPIOC_CLK_ENABLE();

      //+----------------------------------------------------------------+
      //  Name,     PWM->DAC old pin,  Direction,    Enable
      //  USM_0,    PB4,               PC13,         PB1
      //  USM_1,    PB5,               PC14,         PB2
      //  USM_2,    PC8,               PC15,         PB3
      //  USM_3,    PC9,               PC4,          PB9
      //  USM_4,    PB6,               PC5,          PB10
      //  USM_5,    PB7,               PB15,         PB12
      //  USM_6,    PB8,               PB14,         PB13
      //+----------------------------------------------------------------+
      // PB4, PB5, PB6, PB7, PB8, PC8, PC9 are no longer STM32 outputs in this
      // reactor -- release_old_pwm_pins() (called from reaction(startup))
      // switches them to GPIO_MODE_ANALOG so the DAC can drive their pads
      // without contention. I2C now lives on PB11/PC12 (bit-banged), not on
      // any of these seven. DIR/EN pins below are unchanged from USM.lf.

      // Configure output pins (DIR/EN)
      HAL_GPIO_WritePin(GPIOA,  GPIO_PIN_4|GPIO_PIN_5|GPIO_PIN_6, GPIO_PIN_RESET);
      GPIO_InitStruct.Pin = GPIO_PIN_4|GPIO_PIN_5|GPIO_PIN_6;
      GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
      GPIO_InitStruct.Pull = GPIO_PULLDOWN;
      GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;
      HAL_GPIO_Init(GPIOA, &GPIO_InitStruct);

      HAL_GPIO_WritePin(GPIOB,  GPIO_PIN_1|GPIO_PIN_2|GPIO_PIN_3|GPIO_PIN_9|GPIO_PIN_10|
        GPIO_PIN_12|GPIO_PIN_13|GPIO_PIN_14|GPIO_PIN_15, GPIO_PIN_RESET);
      GPIO_InitStruct.Pin = GPIO_PIN_1|GPIO_PIN_2|GPIO_PIN_3|GPIO_PIN_9|GPIO_PIN_10|
                            GPIO_PIN_12|GPIO_PIN_13|GPIO_PIN_14|GPIO_PIN_15;
      GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
      GPIO_InitStruct.Pull = GPIO_PULLDOWN;
      GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;
      HAL_GPIO_Init(GPIOB, &GPIO_InitStruct);

      HAL_GPIO_WritePin(GPIOC,  GPIO_PIN_4|GPIO_PIN_5|GPIO_PIN_13|GPIO_PIN_14|GPIO_PIN_15, GPIO_PIN_RESET);
      GPIO_InitStruct.Pin = GPIO_PIN_4|GPIO_PIN_5|GPIO_PIN_13|GPIO_PIN_14|GPIO_PIN_15;
      GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
      GPIO_InitStruct.Pull = GPIO_PULLDOWN;
      GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;
      HAL_GPIO_Init(GPIOC, &GPIO_InitStruct);

      // Configure input pins (ON/OFF Switch) PC3
      GPIO_InitStruct.Pin = GPIO_PIN_3;
      GPIO_InitStruct.Mode = GPIO_MODE_INPUT;
      GPIO_InitStruct.Pull = GPIO_NOPULL;
      HAL_GPIO_Init(GPIOC, &GPIO_InitStruct);

      // Configure output pin (Status LED)
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0, GPIO_PIN_RESET);
      GPIO_InitStruct.Pin = GPIO_PIN_0;
      GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
      GPIO_InitStruct.Pull = GPIO_NOPULL;
      GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;
      HAL_GPIO_Init(GPIOB, &GPIO_InitStruct);
    }

    void set_motor_enable_pins(bool set_value){
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0,    set_value); // PB0 is the LED
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_1,    set_value);
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_2,    set_value);
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_3,    set_value);
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_9,    set_value);
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_10,   set_value);
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_12,   set_value);
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_13,   set_value);
      //HAL_Delay(1);
    }

    void set_motor_enable_pins_from_array(bool *enable_values){
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_1,    enable_values[0]);
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_2,    enable_values[1]);
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_3,    enable_values[2]);
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_9,    enable_values[3]);
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_10,   enable_values[4]);
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_12,   enable_values[5]);
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_13,   enable_values[6]);
      //HAL_Delay(1);
    }

    void enforce_speed_bounds(){
      for (int i = 0; i<7; i++){
        if (speed_[i] < -motor_configs[i]->max_speed){
          if (PRINT_USM) printf("Speed of speed_[%d]*1000 (%d) is less than --motor_configs[%d]->max_speed*1000 (%d)!\r\n", i, ((int)speed_[i]*1000), i, ((int)(-motor_configs[i]->max_speed*1000)));
          speed_[i] = -motor_configs[i]->max_speed;

        }
        else if (motor_configs[i]->max_speed < speed_[i]){
          speed_[i] = motor_configs[i]->max_speed;
          if (PRINT_USM)printf("Speed of speed_[%d]*1000 (%d) is greater than motor_configs[%d]->max_speed*1000 (%d)!\r\n", i, ((int)speed_[i]*1000), i, ((int)(motor_configs[i]->max_speed*1000)));
        }
        else{
          // speed_[i] is in expected range.
        }
      }
      return;
    }

    void compute_directions_from_speeds(){
      for (int i = 0; i<7; i++){
        motor_directions_[i] = (speed_[i] >= 0); // 1 if non-negative, 0 if negative (+ or - dir respectively)
      }
      return;
    }

    void set_direction_pins(){
      HAL_GPIO_WritePin(GPIOC, GPIO_PIN_13,   motor_directions_[0]); // 1 if non-negative, 0 if negative
      HAL_GPIO_WritePin(GPIOA, GPIO_PIN_5,    motor_directions_[1]);
      HAL_GPIO_WritePin(GPIOA, GPIO_PIN_6,    motor_directions_[2]);
      HAL_GPIO_WritePin(GPIOC, GPIO_PIN_4,    motor_directions_[3]);
      HAL_GPIO_WritePin(GPIOC, GPIO_PIN_5,    motor_directions_[4]);
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_15,   motor_directions_[5]);
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_14,   motor_directions_[6]);
      return;
    }

    void compute_duty_cycles(){
      for (int i = 0; i < 7; i++){
        usm_duty_cycle_[i]  = apply_duty_cycle_limits(speed_[i] / ((float)(motor_configs[i]->pwm_rad_per_sec_max)));
        //usm_duty_cycle_[i] = convert_speed_rad_per_sec_to_duty_cycle(speed_[i]);
      }
      return;
    }

    void set_motor_enable_deadband(){
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0,    1); // PB0 is the LED
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_1,    usm_duty_cycle_[0] > USM_MIN_DUTY_CYCLE);
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_2,    usm_duty_cycle_[1] > USM_MIN_DUTY_CYCLE);
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_3,    usm_duty_cycle_[2] > USM_MIN_DUTY_CYCLE);
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_9,    usm_duty_cycle_[3] > USM_MIN_DUTY_CYCLE);
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_10,   usm_duty_cycle_[4] > USM_MIN_DUTY_CYCLE);
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_12,   usm_duty_cycle_[5] > USM_MIN_DUTY_CYCLE);
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_13,   usm_duty_cycle_[6] > USM_MIN_DUTY_CYCLE);
      return;
    }

    float apply_motor_direction_change(float speed, int index){
      return speed * ((float) motor_configs[index]->dir);
    }

  =}


  reaction(startup) {=
    // for debugging
    reference_tick_usm_dac = HAL_GetTick();

    __HAL_RCC_GPIOA_CLK_ENABLE();
    __HAL_RCC_GPIOB_CLK_ENABLE();
    __HAL_RCC_GPIOC_CLK_ENABLE();

    I2C_Bitbang_Init();
    USM_GPIO_Init();
    release_old_pwm_pins(); // must run after Main.lf's stm32_init() -- see header note

    // Initially set all enable values to 0
    set_motor_enable_pins(false);

    DAC7578_init(); // resets + zeros all DAC channels

    compute_directions_from_speeds();
    set_direction_pins();

    printf("USM_DAC has finished startup!\n");
  =}

  reaction(force_disable_motor_pins) {=
    for (int i = 0; i<7; i++){
      self->force_disable_motor_pins_[i] = force_disable_motor_pins[i]->value;
    }
  =}

  reaction(enable_motor_command) {=
    for (int i = 0; i<7; i++){
      self->enable_motor_command_[i] = enable_motor_command[i]->value;
    }
    set_motor_enable_pins_from_array(self->enable_motor_command_);
    =}

  reaction(speed) -> commanded_duty_cycle{=

    bool any_motor_enabled_ = false;
    for (int i = 0; i<7; i++){
      if (self->enable_motor_command_[i]) any_motor_enabled_ = true;
    }

    if (any_motor_enabled_){
      // save internal speed_ values
      for (int i = 0; i<7; i++){
        //speed_[i] = speed[i]->value;
        speed_[i] = speed[i]->value;
      }

      // Set USM direction values based on sign of speed_
      compute_directions_from_speeds(); // computes the directions
      set_direction_pins(); // sets the directions to the pins

      // compute the duty cycles used for later logic
      compute_duty_cycles(); // updates usm_duty_cycle_ array

      // set motor enable pins based on deadband value of duty cycles
      //set_motor_enable_deadband(); // sets motor enable pins to be true if value is above USM_DUTY_CYCLE_MIN

      // set the DAC outputs
      set_motor_dac_outputs();

      if (PRINT_USM){
        for (int i = 0; i<7;i++){
          printf("Motor %d: Commanding %d milli rads/sec or %d Deg/s.\r\n", i, (int)(1000 * speed_[i]), (int)(RAD_PER_SEC_TO_DEG_PER_SEC * speed_[i]));
        }
      }

      //HAL_Delay(1); // do a HAL delay at the end to allow all the pins to update correctly
      for (int i = 0; i<7; i++) {lf_set(commanded_duty_cycle[i], usm_duty_cycle_[i]);} // usm_duty_cycle_ is set internally by set_motor_dac_outputs
    }
  =}

}
