target C {
  single-threaded: true,
  platform: {
    name: "stm32",
    board: "F446RE"
  },
  files: [
    "../../../src_c/pulse_motor_model.h", "../../../src_c/pulse_motor_model.c",
    "../../../src_c/gaussian_motion.h", "../../../src_c/gaussian_motion.c",
    "../../../src_c/stats.h", "../../../src_c/stats.c"
  ],
  cmake-include: [
    "../../../src_c/pulse_motor_model_cmake.cmake",
    "../../../src_c/gaussian_motion_cmake.cmake",
    "../../../src_c/stats_cmake.cmake"
  ]
}

preamble {=
  #include "pulse_motor_model.h"
  #include "stats.h"
  #include <math.h>
  #include <stdio.h>

  // Nanoseconds -> seconds, same conversion/reasoning as
  // Small_DeltaP_Pulse_Controller.lf's own NS_TO_S -- this reactor times
  // T_start/T_stop observations against physical time the same way that
  // reactor's control_tick does.
  #define NS_TO_S 1e-9f

  // Verbose live edge/detection tracing -- same role/convention as
  // small_deltap_pulse_controller.h's PRINT_DPULSE_DEBUG. Off by default;
  // the per-pulse outcome lines below (PRINT_PME_OBS) are the normal
  // on-hardware observability.
  #define PRINT_PME_DEBUG 0

  // Compact one-line-per-completed-pulse outcome logging (which
  // observations landed, which detector caught onset, dud or not) plus a
  // cumulative counter summary every PME_COUNTER_PRINT_INTERVAL pulses --
  // ON by default: this is how "we're losing pulses" gets attributed to a
  // specific drain (no onset / no rest / short window / dud / watchdog)
  // instead of vanishing silently. Milli-scaled ints, printf-float
  // convention as everywhere else on this platform.
  #define PRINT_PME_OBS 1
  #define PME_COUNTER_PRINT_INTERVAL 20
=}

// Single-channel per-pulse observation gatherer: watches this joint's
// Small_DeltaP_Pulse_Controller (via motor_state_input/planned_pulse_input)
// alongside EncoderStateEstimator's position/velocity output, and emits one
// PulseModelObservation per completed pulse (observation_output below) --
// raw point observations with PER-FIELD validity, see that struct's comment
// in pulse_motor_model.h. Deliberately does NOT maintain or update a model
// of its own: PulseMotorModelEstimatorMixture_Bank.lf owns the one
// authoritative model, pools these observations across joints, and runs the
// epoch test/step/broadcast logic there. The observations themselves are
// model-independent measurements -- model_ below is only used for
// observation GATING (watchdog timeout scale, velocity-onset threshold,
// position-onset latency fallback) and to fill the unobservable fields of
// the observation, which is why raw observations rather than residuals are
// what goes on the wire (residuals would be meaningful only relative to the
// exact model they were subtracted against, forcing all 7 estimators'
// models into lockstep with the bank's).
//
// Motion onset (the T_start observation) is watched by TWO detectors, and
// the first to fire wins (onset_source_ records which, for logging):
//
//   - position: |position - pulse_start_position_| crossing
//     movement_detection_threshold -- guaranteed-motion signal, but its
//     latency is threshold/velocity (velocity-DEPENDENT: ~33 ms at 0.3
//     rad/s, seconds at creep speeds), which both biases T_start late and
//     couples its variance to V_real's. Compensated at pulse end by
//     subtracting threshold/V (this pulse's own measured V when available,
//     else model_.V_real.mean) -- see the pulse_ended block below.
//   - velocity: |velocity_input| (the EncoderStateEstimator observer's
//     filtered velocity, per Main.lf's wiring) crossing
//     onset_velocity_fraction * model_.V_real.mean -- latency is roughly
//     the observer's constant lag instead of threshold/velocity. TODO:
//     characterize that lag and compensate it too.
//
// Both detectors watch through MOTOR_STARTING, MOTOR_RUNNING *and*
// MOTOR_STOPPING (until rest is detected): the FSM's state transitions run
// on model timers, not real motion, so when the real dead time exceeds
// T_start_model + run_duration the motor only starts moving after the FSM
// has already advanced to STOPPING -- watching only STARTING/RUNNING
// silently discarded every such pulse's T_start (a major share of the
// "missing pulses" seen on hardware).
//
// Sits inside PulseMotorModelEstimator_Bank.lf /
// PulseMotorModelEstimatorMixture_Bank.lf, one instance per joint -- same
// split as Small_DeltaP_Pulse_Controller.lf /
// Small_DeltaP_Pulse_Controller_Bank.lf. bank_index is used purely to tag
// log lines with the joint number.
reactor PulseMotorModelEstimator(
  // rad -- shared by the position-onset detector and the rest detector, on
  // opposite sides: while a pulse is in flight, |position -
  // pulse_start_position_| has to clear this before we call the motor
  // actually moving; while MOTOR_STOPPING, consecutive position_input
  // samples have to stay under this before we call the motor actually
  // stopped. Has to sit above encoder noise either way.
  // TODO: characterize against actual encoder noise floor.
  movement_detection_threshold: float = 0.01,
  // Multiplier on (model_.T_start + MAX_PULSE_DURATION_S + model_.T_stop)
  // -- pulse_motor_model.h's ceiling on a planned pulse's run_duration --
  // giving how long after a pulse begins (the STARTING edge) this reactor
  // will wait before concluding the pulse is lost (e.g. a stuck/misbehaving
  // Small_DeltaP_Pulse_Controller, or a dropped motor_state_input/
  // planned_pulse_input connection) and giving up on its observations
  // rather than waiting on them forever -- see the watchdog check in
  // reaction(position_input) below. Deliberately generous: false-negatives
  // (missing a genuinely stuck pulse) just mean one joint stops
  // contributing observations for a while; false-positives (giving up on a
  // pulse that would've finished normally) silently drop real data. TODO:
  // tighten once a real false-positive/negative rate can be characterized.
  pulse_timeout_safety_factor: float = 4.0,
  // s -- minimum V_real window this reactor will divide a position delta
  // by AT ALL: below this the ratio is numerically degenerate (a real
  // nonzero delta over a ~0 window produces a wildly wrong point estimate,
  // worse than none). See v_real_min_window_s below for the separate,
  // higher QUALITY floor.
  min_running_duration_s: float = 0.02,
  // Multiplier on movement_detection_threshold giving the whole-pulse
  // position delta a completed pulse must clear to count as real motion.
  // Below it the pulse is a dud (observation sent with dud = true and no
  // valid fields): encoder noise can cross the onset threshold on a pulse
  // that never actually moved, and folding that pulse's V_real ~= 0 into
  // the pooled stats produces a confident, tightly-clustered, WRONG
  // velocity belief -- exactly the ~5 milli-rad/s cluster seen on joints
  // 3-6 on hardware. 2.5x: comfortably above a noise-crossed onset (~1x)
  // while far below a real pulse's smallest useful delta (convergenceLimit
  // ~3.5x).
  dud_position_delta_factor: float = 2.5,
  // Fraction of model_.V_real.mean the filtered velocity must cross for
  // the velocity-onset detector to latch. 0.5: high enough that observer
  // noise/drift at rest can't fire it, low enough to catch the ramp well
  // before full speed.
  onset_velocity_fraction: float = 0.5,
  // s -- QUALITY floor on the V_real window, above min_running_duration_s's
  // degenerate-math floor: delta/duration's relative error blows up as the
  // window shrinks, so windows in [min_running_duration_s, this) produce a
  // technically-computable but low-quality V_real that would inflate the
  // pooled variance. Such pulses still send their other fields
  // (v_real_valid just stays false) -- with per-field validity that costs
  // nothing.
  v_real_min_window_s: float = 0.05
) {
  input position_input: float
  input velocity_input: float
  input commanded_velocity_input: float
  // Which MotorState this joint's Small_DeltaP_Pulse_Controller is
  // currently in (STOPPED/STARTING/RUNNING/STOPPING) -- see that reactor's
  // motor_state_output. Lets this estimator tell "this motion happened
  // during a specific commanded pulse" apart from "this motion happened
  // during ordinary pass-through," which matters for attributing observed
  // position/velocity back to a particular PulseCommand, and drives all
  // the per-pulse edge detection below.
  input motor_state_input: MotorState
  // The pulse this joint's Small_DeltaP_Pulse_Controller currently has
  // committed to (dir/run_duration/pulse_height) -- see that reactor's
  // planned_pulse_output. Carried into each observation (dud analysis
  // needs the planned duration of the pulse that failed to move).
  input planned_pulse_input: PulseCommand

  // The bank's current authoritative PulseMotorModel, broadcast after each
  // epoch update (see PulseMotorModelEstimatorMixture_Bank.lf) -- refreshes
  // model_ below. Optional in the sense that a stale model_ only slightly
  // mistunes observation gating, never the observations themselves -- see
  // the reactor-level comment above.
  input motor_model_input: PulseMotorModel

  // One PulseModelObservation per completed pulse (unless the watchdog
  // already gave up on it) -- see that struct's comment in
  // pulse_motor_model.h for the per-field validity contract. Only ever
  // lf_set from the pulse_ended branch of reaction(motor_state_input)
  // below, so its presence on any given tick *is* the "a fresh observation
  // is ready" signal.
  output observation_output: PulseModelObservation

  // The bank's model, seeded from pulse_motor_model.h's shared
  // INITIAL_MOTOR_MODEL and refreshed via motor_model_input above. Only
  // read for observation gating and the observation's unobservable fields,
  // never subtracted from an observation -- see the reactor-level comment.
  state model_: PulseMotorModel

  // Latest observed MotorState/PulseCommand, cached from motor_state_input/
  // planned_pulse_input every time either arrives, and the latest observed
  // position/velocity, cached the same way from position_input/
  // velocity_input -- so the edge-detection logic below always has a
  // current value to compare against even though these four inputs each
  // arrive on their own independent tag.
  state last_motor_state_: MotorState
  state last_planned_pulse_: PulseCommand
  state last_position_: float = 0.0
  state last_velocity_: float = 0.0

  // ---- T_start observation: timer armed at the STARTING edge, stopped by
  // whichever onset detector (position/velocity -- see the reactor-level
  // comment) fires first, watched until rest is detected -- through
  // MOTOR_STOPPING too, not just STARTING/RUNNING. ----
  state pulse_start_position_: float = 0.0 // position_ latched at the STARTING edge -- the position-onset baseline, and the pulse's pre-motion position for the whole-pulse delta
  state pulse_start_time_: time = 0        // physical time at the STARTING edge
  state has_t_start_observation_: bool = false // latches true once this pulse's onset has been observed, so both detectors only fire once per pulse
  state t_start_observation_s_: float = 0.0 // seconds, most recent single-pulse observation of T_start (RAW -- position-detector latency compensation happens at pulse end)
  state onset_source_: PulseOnsetSource     // which detector latched this pulse's onset -- PULSE_ONSET_NONE until one does

  // ---- V_real observation window: from the empirical motion onset (the
  // moment the T_start observation latches -- NOT the model-timer-driven
  // STARTING -> RUNNING edge, which would fold genuine dead time into the
  // average and bias V_real low) to the RUNNING -> STOPPING edge. An onset
  // that only lands during MOTOR_STOPPING gives a negative window duration
  // and is excluded from V_real naturally (the T_start observation itself
  // is still good -- that's the point of watching STOPPING). ----
  state real_motion_start_time_: time = 0        // physical time at the moment the onset latched
  state real_motion_start_position_: float = 0.0 // position_ latched at that same moment
  state running_end_position_: float = 0.0   // position_ latched at the RUNNING -> STOPPING edge -- frozen there, unlike stopping_last_checked_position_ below which keeps moving throughout MOTOR_STOPPING
  state has_running_window_observation_: bool = false // latches true at the RUNNING -> STOPPING edge

  // ---- T_stop observation: timer armed at RUNNING -> STOPPING, stopped
  // once position_input shows the motor has actually come to rest --
  // consecutive-sample no-movement check (a fixed baseline can't detect
  // "stopped": the motor keeps coasting throughout MOTOR_STOPPING). ----
  state stopping_start_time_: time = 0     // physical time at the STOPPING edge
  state stopping_last_checked_position_: float = 0.0 // position_ as of the previous position_input sample taken while MOTOR_STOPPING
  state has_t_stop_observation_: bool = false // latches true once this pulse's T_stop has been observed
  state t_stop_observation_s_: float = 0.0 // seconds, most recent single-pulse observation of T_stop

  // Latches true once the watchdog in reaction(position_input) below has
  // already reset this pulse's observations -- so it only fires (and
  // prints) once per stuck pulse, and the eventual pulse_ended for that
  // pulse skips emitting an observation built from garbage. Reset back to
  // false at the next STARTING edge.
  state watchdog_fired_: bool = false

  // ---- Cumulative outcome counters (since startup), printed every
  // PME_COUNTER_PRINT_INTERVAL completed pulses under PRINT_PME_OBS -- the
  // "where are the pulses going" ledger. pulses_ended_ should equal the sum
  // of duds_ + watchdog_resets_ + (pulses that emitted a real
  // observation); onset_missed_/t_stop_missed_/v_real_short_window_ count
  // pulses whose observation went out with that field invalid. ----
  state pulses_ended_: int = 0
  state duds_: int = 0
  state onset_position_count_: int = 0
  state onset_velocity_count_: int = 0
  state onset_missed_: int = 0
  state t_stop_missed_: int = 0
  state v_real_short_window_: int = 0
  state watchdog_resets_: int = 0

  reaction(startup) {=
    self->model_ = INITIAL_MOTOR_MODEL;

    self->last_motor_state_ = MOTOR_STOPPED;
    self->last_planned_pulse_.dir = 1.0f;
    self->last_planned_pulse_.run_duration = 0.0f;
    self->last_planned_pulse_.pulse_height = 0.0f;

    self->onset_source_ = PULSE_ONSET_NONE;
  =}

  // Cache-only for last_position_, plus the position-onset and T_stop
  // detectors and the lost-pulse watchdog.
  reaction(position_input) {=
    self->last_position_ = position_input->value;

    // Watchdog: if we've been anywhere other than MOTOR_STOPPED for way
    // longer than a pulse should ever take, assume this pulse is lost (see
    // pulse_timeout_safety_factor's comment above) and give up on its
    // observations rather than waiting on them forever. Runs off
    // position_input rather than a timer of its own since position_input
    // keeps arriving at the encoder's own cadence regardless of whatever
    // might be wrong with motor_state_input/Small_DeltaP_Pulse_Controller.
    if (self->last_motor_state_ != MOTOR_STOPPED && !self->watchdog_fired_) {
      float expected_max_pulse_s = self->model_.T_start + MAX_PULSE_DURATION_S + self->model_.T_stop;
      float timeout_s = expected_max_pulse_s * self->pulse_timeout_safety_factor;
      float elapsed_s = (float) (lf_time_physical() - self->pulse_start_time_) * NS_TO_S;
      if (elapsed_s > timeout_s) {
        self->has_t_start_observation_ = false;
        self->has_t_stop_observation_ = false;
        self->has_running_window_observation_ = false;
        self->onset_source_ = PULSE_ONSET_NONE;
        self->watchdog_fired_ = true;
        self->watchdog_resets_++;
#if PRINT_PME_OBS
        printf("PME[%d]: WATCHDOG pulse lost (stuck in %s for %d ms > %d ms timeout), observations reset\r\n",
               self->bank_index,
               MotorState_Name(self->last_motor_state_),
               (int) (elapsed_s * 1000.0f),
               (int) (timeout_s * 1000.0f));
#endif
      }
    }

    // Position-onset detector -- watched until rest is detected, including
    // through MOTOR_STOPPING (see the reactor-level comment for why).
    bool pulse_in_flight = (self->last_motor_state_ == MOTOR_STARTING ||
                            self->last_motor_state_ == MOTOR_RUNNING ||
                            (self->last_motor_state_ == MOTOR_STOPPING && !self->has_t_stop_observation_));
    if (pulse_in_flight && !self->has_t_start_observation_) {
      float moved = fabsf(self->last_position_ - self->pulse_start_position_);
      if (moved >= self->movement_detection_threshold) {
        instant_t now = lf_time_physical();
        self->t_start_observation_s_ = (float)(now - self->pulse_start_time_) * NS_TO_S;
        self->has_t_start_observation_ = true;
        self->onset_source_ = PULSE_ONSET_POSITION;
        self->real_motion_start_time_ = now;
        self->real_motion_start_position_ = self->last_position_;
#if PRINT_PME_DEBUG
        printf("PME[%d]: onset(pos) %d ms (moved %d milli-rad >= threshold %d)\r\n",
               self->bank_index,
               (int) (self->t_start_observation_s_ * 1000.0f),
               (int) (moved * 1000.0f),
               (int) (self->movement_detection_threshold * 1000.0f));
#endif
      }
    }

    if (self->last_motor_state_ == MOTOR_STOPPING && !self->has_t_stop_observation_) {
      float moved = fabsf(self->last_position_ - self->stopping_last_checked_position_);
      self->stopping_last_checked_position_ = self->last_position_;
      if (moved < self->movement_detection_threshold) {
        instant_t now = lf_time_physical();
        self->t_stop_observation_s_ = (float)(now - self->stopping_start_time_) * NS_TO_S;
        self->has_t_stop_observation_ = true;
#if PRINT_PME_DEBUG
        printf("PME[%d]: T_stop observed, %d ms (moved %d milli-rad < threshold %d)\r\n",
               self->bank_index,
               (int) (self->t_stop_observation_s_ * 1000.0f),
               (int) (moved * 1000.0f),
               (int) (self->movement_detection_threshold * 1000.0f));
#endif
      }
    }
  =}

  // Cache-only for last_velocity_, plus the velocity-onset detector: the
  // filtered observer velocity crossing onset_velocity_fraction *
  // model_.V_real.mean latches the same onset the position detector
  // watches for, usually earlier and with roughly constant latency -- see
  // the reactor-level comment. Same in-flight window as the position
  // detector, including MOTOR_STOPPING.
  reaction(velocity_input) {=
    self->last_velocity_ = velocity_input->value;

    bool pulse_in_flight = (self->last_motor_state_ == MOTOR_STARTING ||
                            self->last_motor_state_ == MOTOR_RUNNING ||
                            (self->last_motor_state_ == MOTOR_STOPPING && !self->has_t_stop_observation_));
    if (pulse_in_flight && !self->has_t_start_observation_) {
      float onset_speed = self->onset_velocity_fraction * self->model_.V_real.mean;
      if (fabsf(self->last_velocity_) >= onset_speed) {
        instant_t now = lf_time_physical();
        self->t_start_observation_s_ = (float)(now - self->pulse_start_time_) * NS_TO_S;
        self->has_t_start_observation_ = true;
        self->onset_source_ = PULSE_ONSET_VELOCITY;
        self->real_motion_start_time_ = now;
        self->real_motion_start_position_ = self->last_position_;
#if PRINT_PME_DEBUG
        printf("PME[%d]: onset(vel) %d ms (|v| %d milli-rad/s >= %d)\r\n",
               self->bank_index,
               (int) (self->t_start_observation_s_ * 1000.0f),
               (int) (fabsf(self->last_velocity_) * 1000.0f),
               (int) (onset_speed * 1000.0f));
#endif
      }
    }
  =}

  // Per-pulse edge detection: compares the incoming MotorState against
  // last_motor_state_ (still holding the *previous* tick's value at this
  // point) to arm/reset each observation above at the right transition,
  // then updates last_motor_state_ itself last.
  reaction(motor_state_input) -> observation_output {=
    MotorState previous = self->last_motor_state_;
    MotorState next = motor_state_input->value;

#if PRINT_PME_DEBUG
    if (previous != next) {
      printf("PME[%d]: edge %s -> %s\r\n",
             self->bank_index,
             MotorState_Name(previous),
             MotorState_Name(next));
    }
#endif

    // A pulse just ended -- either normally (STOPPING -> STOPPED) or
    // because Small_DeltaP_Pulse_Controller re-armed a new one before ever
    // putting a visible MOTOR_STOPPED on the wire (STOPPING -> STARTING, or
    // even RUNNING -> STARTING, directly). That reactor's control_tick now
    // guards against collapsing STOPPED -> STARTING into the same tick it
    // just landed on STOPPED (see its state_before_advance comment), so the
    // second case shouldn't happen anymore in practice -- this is kept as
    // defense-in-depth so a missed STOPPED can never again silently drop a
    // pulse's observations. previous != MOTOR_STARTING in the second
    // disjunct is required, not redundant: motor_state_input fires every
    // control_tick even when the value hasn't changed, so without it this
    // would also (wrongly) fire on every repeated STARTING tick.
    bool entered_stopped_normally = (previous != MOTOR_STOPPED && next == MOTOR_STOPPED);
    bool skipped_straight_to_starting =
        (next == MOTOR_STARTING && previous != MOTOR_STARTING && previous != MOTOR_STOPPED);
    bool pulse_ended = entered_stopped_normally || skipped_straight_to_starting;

    if (pulse_ended) {
      self->pulses_ended_++;

      if (self->watchdog_fired_) {
        // The watchdog already declared this pulse lost and reset its
        // observations -- anything assembled now would be garbage dressed
        // up as data. Counted (watchdog_resets_, at reset time) but not
        // emitted.
#if PRINT_PME_OBS
        printf("PME[%d]: pulse #%d discarded (watchdog had reset it)\r\n",
               self->bank_index, self->pulses_ended_);
#endif
      } else {
        float position_delta = self->last_position_ - self->pulse_start_position_;

        PulseModelObservation obs;
        obs.values = self->model_;
        obs.t_start_valid = false;
        obs.t_stop_valid = false;
        obs.v_real_valid = false;
        obs.onset_source = self->onset_source_;
        obs.running_window_s = 0.0f;
        obs.position_delta = position_delta;
        obs.planned_run_duration = self->last_planned_pulse_.run_duration;

        // Dud check FIRST: a pulse whose whole-run position delta never
        // cleared the dud threshold produced no real motion, so nothing it
        // "observed" is trustworthy -- in particular a noise-latched onset
        // must not turn into a confident V_real ~= 0 (see
        // dud_position_delta_factor's comment above).
        float dud_threshold = self->dud_position_delta_factor * self->movement_detection_threshold;
        obs.dud = (fabsf(position_delta) < dud_threshold);

        if (!obs.dud) {
          // T_start: raw onset time, minus the position detector's
          // velocity-dependent latency (~threshold/V -- the time real
          // motion needed to accumulate the detection threshold before we
          // could see it). Compensated with this pulse's own measured V
          // when the window is usable, else the model's belief. The
          // velocity detector's latency (observer lag) is roughly constant
          // and NOT yet compensated -- TODO: characterize and subtract it.
          if (self->has_t_start_observation_) {
            float t_start_s = self->t_start_observation_s_;
            if (self->onset_source_ == PULSE_ONSET_POSITION) {
              float running_duration_s = (float) (self->stopping_start_time_ - self->real_motion_start_time_) * NS_TO_S;
              float v_for_compensation = self->model_.V_real.mean;
              if (self->has_running_window_observation_ && running_duration_s > self->min_running_duration_s) {
                v_for_compensation = fabsf(self->running_end_position_ - self->real_motion_start_position_) / running_duration_s;
              }
              if (v_for_compensation > 1e-4f) {
                t_start_s -= self->movement_detection_threshold / v_for_compensation;
              }
              if (t_start_s < 0.0f) t_start_s = 0.0f;
            }
            obs.values.T_start = t_start_s;
            obs.t_start_valid = true;

            if (self->onset_source_ == PULSE_ONSET_POSITION) self->onset_position_count_++;
            else self->onset_velocity_count_++;
          } else {
            self->onset_missed_++;
          }

          if (self->has_t_stop_observation_) {
            obs.values.T_stop = self->t_stop_observation_s_;
            obs.t_stop_valid = true;
          } else {
            self->t_stop_missed_++;
          }

          // V_real from position-delta/duration over the window from
          // empirical onset to the RUNNING -> STOPPING edge. Two floors:
          // min_running_duration_s (degenerate math -- also excludes an
          // onset that only landed during STOPPING, whose window is
          // negative) and v_real_min_window_s (quality -- see that
          // parameter's comment). fabsf: V_real.mean is a magnitude,
          // direction is carried separately via PulseCommand.dir everywhere
          // in this codebase.
          if (self->has_t_start_observation_ && self->has_running_window_observation_) {
            float running_duration_s = (float) (self->stopping_start_time_ - self->real_motion_start_time_) * NS_TO_S;
            float v_real_floor_s = (self->v_real_min_window_s > self->min_running_duration_s)
                                       ? self->v_real_min_window_s
                                       : self->min_running_duration_s;
            if (running_duration_s >= v_real_floor_s) {
              obs.values.V_real.mean = fabsf(self->running_end_position_ - self->real_motion_start_position_) / running_duration_s;
              obs.values.V_real.variance = 0.0f; // one point measurement, not a distribution -- the pulse-to-pulse spread pooled by the bank is the real variance
              obs.running_window_s = running_duration_s;
              obs.v_real_valid = true;
            } else {
              self->v_real_short_window_++;
            }
          } else if (self->has_t_start_observation_) {
            // Onset seen but no RUNNING window at all (e.g. onset during
            // STOPPING) -- same drain bucket as a too-short window.
            self->v_real_short_window_++;
          }
        } else {
          self->duds_++;
        }

        lf_set(observation_output, obs);

#if PRINT_PME_OBS
        printf("PME[%d]: pulse #%d %s onset=%s tstart=%d%s tstop=%d%s vreal=%d%s win=%d dpos=%d plan=%d (ms/milli-units)\r\n",
               self->bank_index,
               self->pulses_ended_,
               obs.dud ? "DUD" : "ok",
               PulseOnsetSource_Name(obs.onset_source),
               (int) (obs.values.T_start * 1000.0f), obs.t_start_valid ? "" : "!",
               (int) (obs.values.T_stop * 1000.0f), obs.t_stop_valid ? "" : "!",
               (int) (obs.values.V_real.mean * 1000.0f), obs.v_real_valid ? "" : "!",
               (int) (obs.running_window_s * 1000.0f),
               (int) (obs.position_delta * 1000.0f),
               (int) (obs.planned_run_duration * 1000.0f));
#endif
      }

#if PRINT_PME_OBS
      if (self->pulses_ended_ % PME_COUNTER_PRINT_INTERVAL == 0) {
        printf("PME[%d]: totals pulses=%d duds=%d onset(pos=%d vel=%d missed=%d) tstop_missed=%d vreal_short=%d watchdog=%d\r\n",
               self->bank_index,
               self->pulses_ended_,
               self->duds_,
               self->onset_position_count_,
               self->onset_velocity_count_,
               self->onset_missed_,
               self->t_stop_missed_,
               self->v_real_short_window_,
               self->watchdog_resets_);
      }
#endif
    }

    if (previous != MOTOR_STARTING && next == MOTOR_STARTING) {
      // Pulse begins: latch the onset baseline/timer and this pulse's
      // pre-motion position (also the whole-pulse delta's baseline). Runs
      // after the pulse_ended block above, which needed the OLD
      // pulse_start_position_ (the pulse that just ended) still intact.
      self->pulse_start_position_ = self->last_position_;
      self->pulse_start_time_ = lf_time_physical();
      self->has_t_start_observation_ = false;
      self->has_running_window_observation_ = false;
      self->onset_source_ = PULSE_ONSET_NONE;
      self->watchdog_fired_ = false;
    }

    if (previous != MOTOR_STOPPING && next == MOTOR_STOPPING) {
      // Pulse is being cut off: arm T_stop's timer and seed the
      // consecutive-sample position check with the position as of this
      // edge (still moving, so this first comparison should not by itself
      // read as "stopped"). Also closes out the RUNNING window:
      // running_end_position_ freezes here, unlike
      // stopping_last_checked_position_ which keeps moving throughout
      // MOTOR_STOPPING.
      self->stopping_start_time_ = lf_time_physical();
      self->stopping_last_checked_position_ = self->last_position_;
      self->has_t_stop_observation_ = false;

      self->running_end_position_ = self->last_position_;
      self->has_running_window_observation_ = true;
    }

    self->last_motor_state_ = next;
  =}

  reaction(planned_pulse_input) {=
    self->last_planned_pulse_ = planned_pulse_input->value;
  =}

  // Applied immediately, unlike Small_DeltaP_Pulse_Controller.lf's
  // MOTOR_STOPPED-latched pending_model_update_: model_ here is only read
  // for gating (watchdog timeout scale, onset thresholds/fallbacks) and
  // the observation's unobservable fields -- neither makes a mid-pulse
  // swap unsafe, since the observations themselves never depend on model_
  // (see the reactor-level comment).
  reaction(motor_model_input) {=
    self->model_ = motor_model_input->value;
  =}
}
