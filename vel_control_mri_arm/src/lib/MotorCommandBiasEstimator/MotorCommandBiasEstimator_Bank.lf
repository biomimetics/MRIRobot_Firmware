target C {
  single-threaded: true,
  platform: {
    name: "stm32",
    board: "F446RE"
  },
  files: [
    "../../../src_c/pulse_motor_model.h", "../../../src_c/pulse_motor_model.c",
    "../../../src_c/gaussian_motion.h", "../../../src_c/gaussian_motion.c",
    "../../../src_c/stats.h", "../../../src_c/stats.c"
  ],
  cmake-include: [
    "../../../src_c/pulse_motor_model_cmake.cmake",
    "../../../src_c/gaussian_motion_cmake.cmake",
    "../../../src_c/stats_cmake.cmake"
  ]
}

import MotorCommandBiasEstimator from "MotorCommandBiasEstimator.lf"

// Top-level preamble so MotorState/PulseMotorModel are visible where the
// port declarations below reference them -- same reasoning as
// PulseMotorModelEstimatorMixture_Bank.lf's own top-level preamble.
preamble {=
  #include "pulse_motor_model.h"
=}

// 7-dof wrapper that routes each joint's commanded/actual velocity,
// pass-through flag, and the shared PulseMotorModel to a bank of
// single-channel MotorCommandBiasEstimator instances -- same instantiation
// split as PulseMotorModelEstimatorMixture_Bank.lf, but UNLIKE that
// reactor's pooled-across-joints design: a command bias is a property of
// THAT joint's specific motor/gearbox/mounting (the whole reason this
// reactor exists -- certain joints have been observed to consistently run
// faster or slower than commanded), so every instance below owns and
// estimates its own independent running average, with no cross-joint
// pooling or shared epoch logic.
reactor MotorCommandBiasEstimator_Bank {
  input[7] commanded_velocity_input: float
  input[7] velocity_input: float
  input[7] is_passthrough_input: bool
  input[7] motor_model_input: PulseMotorModel

  // Per-joint smoothed command bias, routed straight out from each
  // estimator instance -- see that output's comment on
  // MotorCommandBiasEstimator.lf.
  output[7] bias_output: float

  estimators = new[7] MotorCommandBiasEstimator()

  commanded_velocity_input -> estimators.commanded_velocity_input
  velocity_input -> estimators.velocity_input
  is_passthrough_input -> estimators.is_passthrough_input
  motor_model_input -> estimators.motor_model_input

  estimators.bias_output -> bias_output
}
