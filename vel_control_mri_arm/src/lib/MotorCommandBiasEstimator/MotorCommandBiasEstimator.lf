target C {
  single-threaded: true,
  platform: {
    name: "stm32",
    board: "F446RE"
  },
  files: [
    "../../../src_c/pulse_motor_model.h", "../../../src_c/pulse_motor_model.c",
    "../../../src_c/gaussian_motion.h", "../../../src_c/gaussian_motion.c",
    "../../../src_c/lognormal_motion.h", "../../../src_c/lognormal_motion.c",
    "../../../src_c/stats.h", "../../../src_c/stats.c"
  ],
  cmake-include: [
    "../../../src_c/pulse_motor_model_cmake.cmake",
    "../../../src_c/gaussian_motion_cmake.cmake",
    "../../../src_c/stats_cmake.cmake"
  ]
}

/*
TODO:
We should add a guard for the updates similar to the pulse motor model estimator that only does an incremental update if the variance is reasonable (simple z-test or something would do just fine I think).
*/

preamble {=
  #include "pulse_motor_model.h"
  #include "stats.h"
  #include "motor_config.h"
  #include <math.h>
  #include <stdio.h>

  // Verbose per-sample tracing (every gated sample, including outlier
  // rejections) -- off by default, same role as
  // PulseMotorModelEstimator.lf's PRINT_PME_DEBUG.
  #define PRINT_MCB_DEBUG 0

  // Compact one-line status log, printed at a fixed wall-clock cadence
  // (reaction(heartbeat) below) rather than gated on updates_ -- ON by
  // default. Fires on this cadence regardless of whether this instance has
  // ever passed min_samples_before_update, so it's useful for confirming
  // gating/sampling is alive (seen/gated/outlier counts moving) even before
  // this joint has produced its first real update -- same role as
  // PulseMotorModelEstimatorMixture_Bank.lf's reaction(heartbeat).
  // Disabled (2026-07): 7 joints x multi-field heartbeat every 5 s is ~600
  // blocking-printf chars per burst -- same runtime-stall/state-packet-
  // starvation reasoning as PulseMotorModelEstimator.lf's PRINT_PME_OBS.
  #define PRINT_MCB_OBS 0
=}

// Single-channel per-joint online estimator of a commanded-speed-dependent
// command CORRECTION: bias_output ~= |commanded_velocity| -
// |actual_velocity| (positive when the motor runs slower than commanded,
// i.e. the command needs to go UP -- NOT the measured offset
// |actual|-|commanded| itself; adding the measured offset back onto the
// command instead of subtracting it compounds the error instead of
// cancelling it, which an earlier version of this reactor got backwards).
// Exists because certain joints have been observed to consistently run
// faster or slower than commanded during ordinary pass-through control --
// a per-motor/gearbox effect, not a property shared across joints the way
// PulseMotorModel is (see PulseMotorModelEstimator.lf's reactor-level
// comment for that contrast). Sits inside MotorCommandBiasEstimator_Bank.lf,
// one instance per joint, each owning its own independent running estimate
// -- no cross-joint pooling.
//
// Deliberately learned in MAGNITUDE space (fabsf of both sides -- see
// reaction(velocity_input) below), not as a raw signed
// commanded_velocity_input - velocity_input difference: this joint gets
// commanded in both directions, and the underlying effect (gearbox/motor
// running a bit fast or slow) is a property of commanded SPEED, not of
// which way the joint happens to be moving. Pooling signed differences from
// both directions into one running mean would mix two opposite-signed
// quantities that don't share a cause and largely cancel, which is exactly
// what made the very first version of this reactor only appear to correct
// one direction. bias_output is warm-started from
// motor_configs[bank_index]->command_bias (the hard-coded prior -- see
// reaction(startup)) and refined from there by live gated samples, so it's
// always the single total bias this joint currently believes in, in the
// same magnitude-domain units as that prior -- CommandSafetyFilter.lf just
// applies the commanded direction's sign to it (and gates the whole
// correction off when commanded_velocity is exactly 0); it never needs to
// know about the hard-coded prior itself.
//
// Deliberately much simpler than PulseMotorModelEstimator.lf: there's no
// pulse FSM to track edges against here, just a single gated running
// average. A sample is only folded in while
// Small_DeltaP_Pulse_Controller.lf is genuinely pass-through-driving this
// joint (is_passthrough_input true -- see that output's comment) AND the
// commanded speed is at or above the motor's own real minimum-speed floor
// (model_.V_min_cmd), so a small commanded speed the motor barely responds
// to at all doesn't get misread as a large bias.
//
// For now this fits ONE SampleStats per joint over the whole commanded-
// velocity range (bias treated as roughly constant vs. commanded speed).
// TODO: if bias turns out to depend on commanded speed within a joint (not
// just between joints), split into a simple two-bucket regression --
// below/above the midpoint of the commanded-velocity range, each with its
// own SampleStats -- rather than one pooled average.
reactor MotorCommandBiasEstimator(
  // Declaring a parameter with this exact name makes LF auto-assign each
  // bank member its own index -- used purely to tag this joint's log lines
  // below, same convention as PulseMotorModelEstimator.lf's bank_index.
  bank_index: int = 0,
  // Damping on the OUTPUT's step toward bias_stats_'s running mean, applied
  // every gated sample (not once per epoch, unlike
  // PulseMotorModelEstimatorMixture_Bank.lf's step_alpha) -- small by
  // design: gated samples can arrive every QDEC tick (10 ms) during a long
  // pass-through stretch, so a large step_alpha would let the output track
  // sample-to-sample noise instead of the underlying bias. ~0.02 reaches a
  // real, sustained bias within a few seconds of continuous pass-through
  // while a single noisy sample can only nudge the output a tiny amount.
  step_alpha: float = 0.02,
  // rad/s -- hard cap on |step| itself (the amount smoothed_bias_ is
  // allowed to move in a SINGLE update), independent of step_alpha.
  // step_alpha alone only bounds the step as a FRACTION of the gap to
  // bias_stats_'s current mean -- if that mean itself has swung a long way
  // (e.g. a burst of bad-but-not-quite-outlier samples, or a genuine sharp
  // regime change), a fixed fraction of a large gap can still be a large
  // absolute jump. This clamps the worst case regardless of gap size, so
  // command_velocity + bias_output can never move in one update by more
  // than this.
  max_step_per_update: float = 0.050,
  // Minimum bias_stats_ sample count before the output is trusted/emitted
  // at all -- below this the running mean itself is too noisy to step
  // toward. At 10 ms/sample this is ~0.2 s of continuous pass-through.
  min_samples_before_update: int = 50,
  // rad/s -- safety clamp on the smoothed output: a bad stretch of samples
  // (e.g. encoder glitch, EMI) can never make this reactor claim a bias
  // larger than a joint's own command floor is plausible for. Generous on
  // purpose, same "backstop not a tuning knob" reasoning as
  // pulse_motor_model.h's PULSE_MODEL_* bounds. TODO: tighten once real
  // per-joint bias magnitudes are characterized on hardware.
  max_bias_magnitude: float = 0.500,
  // Whole-sample outlier trim on the raw (commanded_velocity - velocity)
  // bias sample, same role/shape as
  // PulseMotorModelEstimatorMixture_Bank.lf's outlier_sigma/
  // outlier_min_samples -- inert (SampleStats_IsOutlier always false) until
  // bias_stats_ has outlier_min_samples, so an instance's first few samples
  // are never rejected against an untrustworthy mean.
  outlier_sigma: float = 2.0,
  outlier_min_samples: int = 10,
  // Wall-clock cadence for reaction(heartbeat)'s status print -- slow on
  // purpose (this is a background health check, not per-sample tracing;
  // PRINT_MCB_DEBUG above is for that), same 5 s default as
  // PulseMotorModelEstimatorMixture_Bank.lf's own heartbeat.
  heartbeat_period: time = 5 s,
  update_bias: bool = true,
  target_percent_of_command: float = 0.9,
  // if current smoothed bias is within +/-update_sigma * SD,
  // skip the update to avoid huge jumps or bad estimates when the variance is too large
  update_sigma: float = 1.0,
  // For builds WITHOUT a pulse controller (minimal Main.lf): ignore
  // is_passthrough_input and derive the pass-through gate locally instead.
  // The command path is direct pass-through by construction in those
  // builds, so a sample counts whenever both the commanded and measured
  // velocities are above derived_passthrough_min_velocity -- either one
  // near zero means the joint is stopped or stalled, which is not a clean
  // commanded-vs-actual comparison (stalled samples are what polluted
  // bias_stats_ with ~0.9*|cmd| garbage in the 2026-07 MRI runs).
  derive_passthrough: bool = false,
  // rad/s -- floor for the derived gate above. Same order as
  // CommandSafetyFilter's velocity_zero_threshold (encoder noise floor).
  derived_passthrough_min_velocity: float = 0.02
) {
  // The command actually sent to the USM for this joint --
  // Small_DeltaP_Pulse_Controller.lf's command_velocity_output, which
  // equals its desired_velocity_ input exactly while
  // is_passthrough_input is true (see that reactor). rad/s, signed.
  input commanded_velocity_input: float
  // This joint's filtered actual velocity -- EncoderStateEstimator.lf's
  // velocity_output. rad/s, signed, same sign convention as
  // commanded_velocity_input.
  input velocity_input: float
  // Small_DeltaP_Pulse_Controller.lf's is_passthrough_output for this
  // joint -- true only while that instance is relaying
  // commanded_velocity_input straight through with no pulse FSM in
  // between, i.e. exactly the condition under which comparing
  // commanded_velocity_input against velocity_input is a clean measurement
  // of this joint's command bias rather than pulse-planning error.
  input is_passthrough_input: bool
  // The shared PulseMotorModel, broadcast by
  // PulseMotorModelEstimatorMixture_Bank.lf -- only read here for
  // V_min_cmd, the gating floor below. Applied immediately on arrival, same
  // reasoning as PulseMotorModelEstimator.lf's motor_model_input (only used
  // for gating, never for the estimate itself, so there's no unsafe moment
  // to apply it in). Deliberately read fresh from model_ on every sample
  // rather than cached once at startup: V_min_cmd is currently a fixed
  // constant (INITIAL_MOTOR_MODEL), but is expected to become its own live
  // estimate later, and this reactor's gate should track whatever the
  // system currently believes V_min_cmd to be without needing a code change
  // here when that happens.
  input motor_model_input: PulseMotorModel

  // Smoothed running estimate of this joint's TOTAL command bias, rad/s --
  // a magnitude-domain offset (see the reactor-level comment), not a signed
  // velocity. Warm-started from motor_configs[bank_index]->command_bias at
  // startup (see reaction(startup)) rather than 0.0, and lf_set once
  // immediately there so a consumer has a real value from tick one -- live
  // gated samples then refine it away from that hand-set starting guess.
  output bias_output: float

  state model_: PulseMotorModel
  state last_commanded_velocity_: float = 0.0
  state last_is_passthrough_: bool = false

  // Running stats over gated raw magnitude-domain CORRECTION samples
  // (fabsf(commanded_velocity_input) - fabsf(velocity_input) -- positive
  // when the motor is running slower than commanded, i.e. the command
  // needs to go UP to hit the real target; see reaction(velocity_input))
  // -- see the reactor-level comment on why this is a single pooled
  // SampleStats rather than a per-command-range split for now.
  state bias_stats_: SampleStats
  // The actual output value -- stepped toward bias_stats_'s mean each
  // gated sample, damped by step_alpha. Kept separate from
  // SampleStats_Mean(bias_stats_) itself (which reacts to the newest sample
  // immediately) precisely so instability/thermal-noise-driven swings in
  // the raw mean can't jump straight to the output -- see step_alpha's
  // comment.
  state smoothed_bias_: float = 0.0

  // Cumulative counters (since startup), printed every heartbeat_period
  // under PRINT_MCB_OBS -- see reaction(heartbeat).
  state samples_seen_: int = 0
  state samples_gated_: int = 0
  state samples_outlier_: int = 0
  state updates_: int = 0

  // Diagnostic only -- fires on a wall-clock cadence regardless of whether
  // any samples have actually landed, same role/reasoning as
  // PulseMotorModelEstimatorMixture_Bank.lf's own heartbeat timer.
  timer heartbeat(0, heartbeat_period)

  reaction(startup) -> bias_output {=
    printf("[STARTUP] MotorCommandBiasEstimator[%d]: entering startup\r\n", self->bank_index);
    self->model_ = INITIAL_MOTOR_MODEL;
    SampleStats_Init(&self->bias_stats_);

    if (self->target_percent_of_command < 0.0){
      self->target_percent_of_command = 0.0;
    }
    else if (1.0 < self->target_percent_of_command){
      self->target_percent_of_command = 1.0;
    }


    // Warm start -- see bias_output's comment and command_bias's comment on
    // Motor_Config (motor_config.h). 0.0 for every joint until bench-
    // characterized, at which point setting it there gets that joint a
    // correct-from-boot bias instead of waiting on live samples to climb
    // there via step_alpha/max_step_per_update.
    self->smoothed_bias_ = motor_configs[self->bank_index]->command_bias;
    lf_set(bias_output, self->smoothed_bias_);
    printf("[STARTUP] MotorCommandBiasEstimator[%d]: exiting startup\r\n", self->bank_index);
  =}

  // Thin cache-only reactions, declared/reacted-to before velocity_input's
  // reaction (where the actual update runs) so that reaction's caches are
  // already fresh -- same convention as EncoderStateEstimator.lf and
  // PulseMotorModelEstimator.lf.
  reaction(commanded_velocity_input) {=
    self->last_commanded_velocity_ = commanded_velocity_input->value;
  =}

  reaction(is_passthrough_input) {=
    self->last_is_passthrough_ = is_passthrough_input->value;
  =}

  reaction(motor_model_input) {=
    self->model_ = motor_model_input->value;
  =}

  // The actual estimation step, once per velocity sample: gate, fold,
  // step, emit.
  reaction(velocity_input) -> bias_output {=
    self->samples_seen_++;

    bool above_v_min_cmd = fabsf(self->last_commanded_velocity_) >= self->model_.V_min_cmd;

    // Pass-through gate: normally the pulse controller's cached
    // is_passthrough flag; with derive_passthrough set (no pulse controller
    // in the build, is_passthrough_input unconnected) derive it locally --
    // see the parameter's comment.
    bool is_passthrough = self->last_is_passthrough_;
    if (self->derive_passthrough) {
      is_passthrough =
          (fabsf(self->last_commanded_velocity_) > self->derived_passthrough_min_velocity) &&
          (fabsf(velocity_input->value) > self->derived_passthrough_min_velocity);
    }

    if (!is_passthrough || !above_v_min_cmd) {
      return;
    }
    self->samples_gated_++;

    // raw sample for the bias correction accumulation. we want to estimate the bias that gives us a percentage of the actual command to avoid overshoot and oscilliation. 
    float raw_bias = fabsf(self->last_commanded_velocity_) * self->target_percent_of_command - fabsf(velocity_input->value);

    // check if the sample is very far from expected, if so we shouldn't add it to the running stats
    if (SampleStats_IsOutlier(&self->bias_stats_, raw_bias, self->outlier_sigma,
                              (uint32_t) self->outlier_min_samples)) {
      self->samples_outlier_++;
#if PRINT_MCB_DEBUG
      printf("MCB[%d]: sample rejected as outlier (bias=%d milli-rad/s, cmd=%d)\r\n",
             self->bank_index, (int) (raw_bias * 1000.0f),
             (int) (self->last_commanded_velocity_ * 1000.0f));
#endif
      return;
    }

    SampleStats_Add(&self->bias_stats_, raw_bias);

#if PRINT_MCB_DEBUG
    printf("MCB[%d]: sample folded (bias=%d milli-rad/s, cmd=%d, n=%lu)\r\n",
           self->bank_index, (int) (raw_bias * 1000.0f),
           (int) (self->last_commanded_velocity_ * 1000.0f),
           (unsigned long) SampleStats_Count(&self->bias_stats_));
#endif

    if (SampleStats_Count(&self->bias_stats_) < (uint32_t) self->min_samples_before_update) {
      return;
    }

    // check if the current bias is far away enough to warrent an update towards the running mean (protects against bad updates if the variance is huge)
    if (!SampleStats_IsOutlier(&self->bias_stats_, self->smoothed_bias_, self->update_sigma,
                              (uint32_t) self->outlier_min_samples)){
                                return;
      }

    float target = SampleStats_Mean(&self->bias_stats_);
    float step = self->step_alpha * (target - self->smoothed_bias_);
    if (step > self->max_step_per_update) {
      step = self->max_step_per_update;
    } else if (step < -self->max_step_per_update) {
      step = -self->max_step_per_update;
    }

    // actually handles the update
    self->smoothed_bias_ += step;

    if (self->smoothed_bias_ > self->max_bias_magnitude) {
      self->smoothed_bias_ = self->max_bias_magnitude;
    } else if (self->smoothed_bias_ < -self->max_bias_magnitude) {
      self->smoothed_bias_ = -self->max_bias_magnitude;
    }

    // if update_bias is false, we want to accumulate the bias stats but not have downstream updates
    if (self->update_bias){
      self->updates_++;
      lf_set(bias_output, self->smoothed_bias_);
    }

  =}

  reaction(heartbeat) {=
#if PRINT_MCB_OBS
    // SampleVariance (n-1 denominator), same convention as
    // PulseMotorModelEstimatorMixture_Bank.lf's V_real.variance print --
    // how wide the pooled bias_stats_ spread is, independent of
    // smoothed_bias_/step_alpha's own damping.
    printf("MCB[%d]: bias=%d (stats_mean=%d stats_var=%d n=%lu) seen=%d gated=%d outliers=%d updates=%d (ms/milli-units)\r\n",
           self->bank_index,
           (int) (self->smoothed_bias_ * 1000.0f),
           (int) (SampleStats_Mean(&self->bias_stats_) * 1000.0f),
           (int) (SampleStats_SampleVariance(&self->bias_stats_) * 1000.0f),
           (unsigned long) SampleStats_Count(&self->bias_stats_),
           self->samples_seen_, self->samples_gated_, self->samples_outlier_,
           self->updates_);
#endif
  =}
}
