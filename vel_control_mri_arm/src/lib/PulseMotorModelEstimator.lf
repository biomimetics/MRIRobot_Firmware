target C {
  single-threaded: true,
  platform: {
    name: "stm32",
    board: "F446RE"
  },
  files: [
    "../../src_c/pulse_motor_model.h", "../../src_c/pulse_motor_model.c"
  ],
  cmake-include: [
    "../../src_c/pulse_motor_model_cmake.cmake"
  ]
}

preamble {=
  #include "pulse_motor_model.h"
=}

// Placeholder for a future running parameter estimator: the intent is to
// compare each joint's commanded velocity/pulses against
// EncoderStateEstimator's position/velocity output to refine that joint's
// PulseMotorModel (V_min, gain, V_variance, etc.) live, then hand the updated
// model to Small_DeltaP_Pulse_Controller.lf via its
// motor_model_update_input for more accurate pulse-duration planning (see
// that reactor's comment on motor_model_update_input for why it's only
// applied at MOTOR_STOPPED).
//
// Wired in now, ahead of the actual estimation logic, so the signal chain
// exists end to end -- this reactor doesn't compute or send anything yet;
// motor_model_output is declared but no reaction ever sets it.
reactor PulseMotorModelEstimator {
  input[7] position_input: float
  input[7] velocity_input: float
  input[7] commanded_velocity_input: float
  // Which MotorState each joint's Small_DeltaP_Pulse_Controller is
  // currently in (STOPPED/STARTING/RUNNING/STOPPING) -- see that reactor's
  // motor_state_output. Lets a future estimator tell "this motion happened
  // during a specific commanded pulse" apart from "this motion happened
  // during ordinary pass-through," which matters for attributing observed
  // position/velocity back to a particular PulseCommand.
  input[7] motor_state_input: MotorState

  output[7] motor_model_output: PulseMotorModel

  // Per-joint running estimate, seeded from pulse_motor_model.h's shared
  // INITIAL_MOTOR_MODEL -- same starting belief
  // Small_DeltaP_Pulse_Controller.lf's own model_ starts from. Not yet
  // refined by anything (see the reactor-level comment above) or sent
  // anywhere.
  state models_: PulseMotorModel[7]

  reaction(startup) {=
    for (int i = 0; i < 7; i++) {
      self->models_[i] = INITIAL_MOTOR_MODEL;
    }
  =}
}
